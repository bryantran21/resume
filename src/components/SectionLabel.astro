---
interface Props { num: string; label: string; }
const { num, label } = Astro.props;
---
<div class="section-label">
  <span class="num">{num}</span>
  <span class="text">{label}</span>
  <span class="hair"></span>
</div>
<style>
  .section-label { display:flex; align-items:center; gap:14px; margin-bottom:2rem; }
  .num  { font-family: var(--font-mono); font-size:.8125rem; font-weight:500; color:var(--accent); }
  .text { font-size:.8125rem; font-weight:500; letter-spacing:.02em; color:var(--text); }
  .hair { flex:1; height:1px; background:var(--border); }
</style>
