---
const { title, description, size = "small", href } = Astro.props;
---

<a class={`card ${size}`} href={href}>
  <div class="card-glow"></div>
  <div class="content">
    <div class="header-group">
      <h3>{title}</h3>
      {description && <p>{description}</p>}
    </div>
    
    <slot /> 
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: #0a0a0a;
    color: white;
    border-radius: 28px;
    padding: 30px;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    min-height: 220px; /* Matched to TravelCard */
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.3s ease;
  }

  /* The Signature Purple Glow */
  .card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 120%, 
      rgba(159, 85, 255, 0.15) 0%, 
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    z-index: 1;
  }

  .card:hover {
    transform: scale(1.02);
    border-color: rgba(159, 85, 255, 0.4);
  }

  .card:hover .card-glow {
    opacity: 1;
  }

  .content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between; /* This pushes title to top, stats to bottom */
  }

  .header-group h3 {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .header-group p {
    margin: 6px 0 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  /* --- Stats Logic --- */
  :global(.stats-container) {
    margin-top: auto; /* Ensures it stays at the bottom */
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 1.5rem;
  }

  :global(.stat-item) {
    display: flex;
    flex-direction: column;
  }

  :global(.stat-label) {
    font-size: 0.7rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  :global(.stat-value) {
    font-size: 2.8rem;
    font-weight: 800;
    color: #9F55FF;
    line-height: 1;
    margin-top: 4px;
  }

  :global(.team-badges) {
    display: flex;
    gap: 16px;
    margin-bottom: 8px;
  }

:global(.team-badges img) {
    /* 1. Define the "Box" */
    width: 48px; 
    height: 48px;

    /* 2. Prevent Stretching (CRITICAL) */
    object-fit: contain; 
    
    /* 3. Visual Polish */
    background: rgba(255, 255, 255, 0.03); /* subtle backing */
    padding: 6px; 
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);

    /* 4. Effects */
    filter: drop-shadow(0 0 8px rgba(159, 85, 255, 0.1));
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.team-badges img:hover) {
    transform: translateY(-4px) scale(1.1);
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--accent-purple);
  }

  :global(.team-badges img:hover) {
    filter: drop-shadow(0 0 12px rgba(159, 85, 255, 0.4)) grayscale(0);
    transform: scale(1.1);
  }

  /* Size variants */
  .small { grid-column: span 1; }
  .wide { grid-column: span 2; }
  .big { grid-column: span 2; grid-row: span 2; }
  .full  { grid-column: span 4; }

  @media (max-width: 768px) {
    .card { padding: 24px; min-height: 180px; }
  }

  @media (max-width: 900px) {
    .full, .wide, .big { grid-column: span 2; }
  }

  @media (max-width: 600px) {
    .full, .wide, .big { grid-column: span 1; }
  }
</style>