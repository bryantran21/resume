---
const { title, description, size = "small", href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class={`card ${size}`} href={href}>
  <div class="content">
    <div class="header-group">
      <h3>{title}</h3>
      {description && <p>{description}</p>}
    </div>
    <slot />
  </div>
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--panel);
    color: var(--text);
    padding: 24px;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    min-height: 220px;
  }

  .content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .header-group h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .header-group p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  /* Size variants (4-col grid) */
  .small { grid-column: span 1; }
  .wide  { grid-column: span 2; }
  .big   { grid-column: span 2; grid-row: span 2; }
  .full  { grid-column: span 4; }

  @media (max-width: 768px) { .card { min-height: 180px; } }
  @media (max-width: 900px) { .full, .wide, .big { grid-column: span 2; } }
  @media (max-width: 600px) { .full, .wide, .big { grid-column: span 1; } }
</style>
