---
import Layout from '../layouts/Layout.astro';

const experiences = [
  {
    company: 'IBM',
    logo: '/logos/ibm.jpg',
    role: 'Application Developer',
    location: 'Baton Rouge, LA',
    period: 'June 2023 - Present',
    achievements: [
      'Managed Help Desk tickets using Jira, streamlining issue tracking and communication between developers and end users',
      'Spearheaded the integration of Zephyr for Jira to standardize and document QA test cases for new ADE features',
      'Initiated migration from IL2 to IL4, helping leadership align on long-term security and compliance goals',
      'Built a Helpdesk Documentation tab within the internal "Helpdesk Toolbox" to centralize SOPs, troubleshooting steps, and triage workflows',
      'Developed Angular pages with TypeScript featuring role-based access control and reusable UI components',
      'Created detailed wireframes of legacy applications to guide modernization efforts',
      'Developed backend services in Java with 90%+ code coverage using Mockito'
    ]
  },
  {
    company: 'LSU Information Technology Services',
    logo: '/logos/lsu.jpg',
    role: 'Student Web Developer',
    location: 'Baton Rouge, LA',
    period: 'May 2022 - May 2023',
    achievements: [
        "Diagnosed and resolved application crashes through log analysis and DevOps tooling",
        "Remodeled LSU's applications for WCAG accessibility using WAVE, HTML, and CSS",
        "Migrated Java applications to Spring Boot by resolving complex Maven dependency conflicts"
    ]
  },
  {
    company: 'TAG Data Solutions',
    logo: '/logos/tag.jpg',
    role: 'Full Stack Web Developer',
    location: 'Remote',
    period: 'January 2022 - May 2022',
    achievements: [
      'Conceptualized custom software functionality for laboratory animal clinics',
      'Developed user interfaces using standard HTML/CSS/PHP/Javascript practices',
      'Designed relational database schemas and applied front-end requirements via BackboneJS'
    ]
  },
  {
    company: 'MAPP',
    logo: '/logos/mapp.jpg',
    role: 'IT Intern',
    location: 'Baton Rouge, LA',
    period: 'March 2021 - Dec 2021',
    achievements: [
      'Provided technical support and hardware configuration for cross-departmental users',
      "Architected Power BI dashboards to visualize contract growth and bid data",
      'Built internal workflow applications using the Microsoft Power Platform',
      'Managed enterprise user data and security protocols as an IT Administrator'
    ]
  }
];

const education = [
  {
    school: 'Georgia Tech',
    logo: '/logos/gatech.png',
    degree: 'MS Computer Science',
    period: 'Aug 2026 - Present',
    gpa: 'n/a',
    coursework: ['Graduate Algorithms', 'Machine Learning', 'Software Architecture', 'Info Security']
  },
  {
    school: 'Louisiana State University',
    logo: '/logos/lsu.jpg',
    degree: 'BS Computer Science',
    period: 'Aug 2019 - May 2023',
    gpa: '3.4',
    coursework: ['Data Structures', 'Operating Systems', 'Database Management', 'Cloud Computing', 'Cybersecurity']
  }
];

const certificates = [
  { name: 'AWS Cloud Practitioner', issuer: 'Amazon', icon: 'fab fa-aws' },
  { name: 'Azure Fundamentals', issuer: 'Microsoft', icon: 'fab fa-microsoft' },
  { name: 'Security Clearance: Secret', issuer: 'US Navy', icon: 'fas fa-shield-alt' },
  { name: 'Foundational C#', issuer: 'Microsoft', icon: 'fab fa-microsoft' },
];
---

<Layout title="Bryan Tran - Resume" description="Software Developer specializing in Full Stack Development">
  <div class="resume-page">
    
    <nav class="navbar">
      <a href="/" class="logo">BRYAN</a>
      <div class="nav-links">
        <a href="/about" class="nav-link">About</a>
        <a href="/resume" class="nav-link active">Resume</a>
        <a href="/projects" class="nav-link">Projects</a>
        <a href="#" class="nav-link">Sign In</a>
      </div>
    </nav>

    <div class="content-wrapper">
      <div class="resume-hero">
        <h1>Resume</h1>
        <p class="subtitle">Full Stack Developer & Problem Solver</p>
        <a href="/Bryan_Tran_Resume.pdf" download class="download-btn">
          <i class="fas fa-download"></i>
          Download PDF
        </a>
      </div>

      <section class="section">
        <h2 class="section-label">Experience</h2>
        <div class="timeline">
          {experiences.map(exp => (
            <div class="experience-card">
              <div class="card-header">
                <div class="company-info">
                  <div class="logo-wrapper"><img src={exp.logo} alt={exp.company} class="company-logo" /></div>
                  <div>
                    <h3>{exp.role}</h3>
                    <p class="company-name">{exp.company}</p>
                  </div>
                </div>
                <div class="meta">
                  <p class="period">{exp.period}</p>
                  <p class="location">{exp.location}</p>
                </div>
              </div>
              <ul class="achievements">
                {exp.achievements.map(achievement => <li>{achievement}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="section">
        <h2 class="section-label">Technical Arsenal</h2>
        
        <div class="tech-category">
          <h3 class="tech-category-title">Frontend</h3>
          <div class="tech-grid">
            <div class="tech-item" data-tech="react"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg" /></div><span>React</span></div>
            <div class="tech-item" data-tech="angular"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/angular/angular-original.svg" /></div><span>Angular</span></div>
            <div class="tech-item" data-tech="nextjs"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nextjs/nextjs-original.svg" /></div><span>Next.js</span></div>
            <div class="tech-item" data-tech="typescript"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg" /></div><span>TypeScript</span></div>
            <div class="tech-item" data-tech="tailwind"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tailwindcss/tailwindcss-original.svg" /></div><span>Tailwind</span></div>
            <div class="tech-item" data-tech="astro"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg" /></div><span>Astro</span></div>
            <div class="tech-item" data-tech="bootstrap"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/bootstrap/bootstrap-original.svg" /></div><span>Bootstrap</span></div>
            <div class="tech-item" data-tech="html"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg" /></div><span>HTML5</span></div>
            <div class="tech-item" data-tech="css"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg" /></div><span>CSS3</span></div>
          </div>
        </div>

        <div class="tech-category">
          <h3 class="tech-category-title">Backend & Database</h3>
          <div class="tech-grid">
            <div class="tech-item" data-tech="java"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg" /></div><span>Java</span></div>
            <div class="tech-item" data-tech="spring"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/spring/spring-original.svg" /></div><span>Spring Boot</span></div>
            <div class="tech-item" data-tech="nodejs"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg" /></div><span>Node.js</span></div>
            <div class="tech-item" data-tech="python"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" alt="Python" /></div><span>Python</span></div>          
            <div class="tech-item" data-tech="mysql"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg" /></div><span>MySQL</span></div>
            <div class="tech-item" data-tech="mongodb"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mongodb/mongodb-original.svg" /></div><span>MongoDB</span></div>
            <div class="tech-item" data-tech="csharp"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/csharp/csharp-original.svg" /></div><span>C#</span></div>
            <div class="tech-item" data-tech="php"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/php/php-original.svg" /></div><span>PHP</span></div>
            <div class="tech-item" data-tech="oracle"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/oracle/oracle-original.svg" /></div><span>Oracle</span></div>
          </div>
        </div>

        <div class="tech-category">
          <h3 class="tech-category-title">DevOps & Tools</h3>
          <div class="tech-grid">
            <div class="tech-item" data-tech="aws"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/amazonwebservices/amazonwebservices-plain-wordmark.svg" /></div><span>AWS</span></div>
            <div class="tech-item" data-tech="azure"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/azure/azure-original.svg" /></div><span>Azure</span></div>
            <div class="tech-item" data-tech="docker"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg" /></div><span>Docker</span></div>
            <div class="tech-item" data-tech="git"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg" /></div><span>Git</span></div>
            <div class="tech-item" data-tech="jira"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/jira/jira-original.svg" /></div><span>Jira</span></div>
            <div class="tech-item" data-tech="maven"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/maven/maven-original.svg" /></div><span>Maven</span></div>
            <div class="tech-item" data-tech="vscode"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vscode/vscode-original.svg" /></div><span>VS Code</span></div>
            <div class="tech-item" data-tech="figma"><div class="tech-icon-wrapper"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/figma/figma-original.svg" /></div><span>Figma</span></div>
          </div>
        </div>
      </section>

      <section class="section dual-grid">
        <div class="edu-column">
          <h2 class="section-label">Education</h2>
          <div class="edu-list">
            {education.map(edu => (
              <div class="interactive-edu-card">
                <div class="edu-header">
                    <img src={edu.logo} alt={edu.school} class="edu-logo-small" />
                    <div class="edu-info">
                      <h3>{edu.school}</h3>
                      <p>{edu.degree} <span class="gpa-tag">GPA {edu.gpa}</span></p>
                    </div>
                </div>
                <div class="edu-details">
                  <p class="edu-period">{edu.period}</p>
                  <div class="course-list">
                      {edu.coursework.map(course => <span class="course-tag">{course}</span>)}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="cert-column">
          <h2 class="section-label">Certifications</h2>
          <div class="cert-list">
            {certificates.map(cert => (
              <div class="cert-item-minimal">
                <i class={cert.icon}></i>
                <div class="cert-text">
                  <h4>{cert.name}</h4>
                  <p>{cert.issuer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  :root {
    --bg-main: #000000;
    --card-surface: #0a0a0a;
    --accent-purple: #9F55FF;
    --text-primary: #ffffff;
    --text-secondary: #888888;
    --border-dim: rgba(255, 255, 255, 0.08);
  }

  .resume-page {
    background-color: var(--bg-main);
    color: var(--text-primary);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    min-height: 100vh;
  }

  /* --- THE UNIVERSAL GLASS PILL --- */
  .navbar {
    position: fixed;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    
    display: flex;
    justify-content: space-between;
    align-items: center;
    
    width: 90%;
    max-width: 850px; 
    padding: 0.8rem 2.5rem;
    
    background: rgba(10, 10, 10, 0.4);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 100px;
  }

  .logo {
    font-size: 1.1rem;
    font-weight: 800;
    color: white;
    letter-spacing: 0.1em; 
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.3s ease;
    position: relative;
    padding: 6px 0;
  }

  .nav-link:hover, 
  .nav-link.active {
    color: white;
  }

  /* The Growing Underline */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--accent-purple);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateX(-50%);
    border-radius: 2px;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  /* Content Spacing */
  .content-wrapper {
    padding-top: 8rem;
    padding-bottom: 6rem;
  }

  /* Hero */
  .resume-hero { text-align: center; padding: 4rem 2rem; }
  .resume-hero h1 { font-size: clamp(3rem, 7vw, 4.5rem); font-weight: 800; letter-spacing: -0.04em; margin-bottom: 1rem; }
  .resume-hero .subtitle { font-size: 1.5rem; color: var(--text-secondary); margin-bottom: 2.5rem; }
  
  .download-btn { 
    display: inline-flex; 
    align-items: center; 
    gap: 0.75rem; 
    padding: 1rem 2.5rem; 
    background: white; 
    color: black; 
    border-radius: 100px; 
    font-weight: 600; 
    text-decoration: none; 
    transition: 0.3s; 
  }
  .download-btn:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(159, 85, 255, 0.3); }

  /* Sections */
  .section { max-width: 1000px; margin: 0 auto 6rem; padding: 0 2rem; }
  .section-label { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent-purple); margin-bottom: 3rem; font-weight: 700; }

  /* Experience Cards */
  .experience-card { background: var(--card-surface); border: 1px solid var(--border-dim); border-radius: 24px; padding: 3rem; margin-bottom: 2rem; transition: 0.4s cubic-bezier(0.23, 1, 0.32, 1); }
  .experience-card:hover { border-color: rgba(159, 85, 255, 0.4); transform: translateY(-5px); }
  .card-header { display: flex; justify-content: space-between; margin-bottom: 2.5rem; }
  .logo-wrapper { width: 54px; height: 54px; background: white; border-radius: 12px; display: flex; align-items: center; justify-content: center; padding: 6px; }
  .company-logo { width: 100%; height: auto; object-fit: contain; }
  .company-info { display: flex; gap: 1.5rem; align-items: center; }
  .company-info h3 { font-size: 1.6rem; font-weight: 700; margin: 0; letter-spacing: -0.02em; }
  .company-name { color: var(--accent-purple); font-weight: 600; font-size: 1.1rem; margin-top: 4px; }
  .meta { text-align: right; }
  .period { font-weight: 600; margin: 0; }
  .location { color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px; }
  .achievements { list-style: none; padding: 0; }
  .achievements li { color: #cecece; margin-bottom: 1.25rem; line-height: 1.7; padding-left: 1.5rem; position: relative; font-size: 1.05rem; }
  .achievements li::before { content: "•"; color: var(--accent-purple); position: absolute; left: 0; font-weight: bold; }

  /* Tech Grid */
  .tech-category-title { color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 2rem; text-transform: uppercase; }
  .tech-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 1.5rem; margin-bottom: 4rem; }
  .tech-item { background: var(--card-surface); border: 1px solid var(--border-dim); border-radius: 20px; padding: 2rem 1rem; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; transition: 0.4s cubic-bezier(0.23, 1, 0.32, 1); }
  .tech-item:hover { border-color: var(--accent-purple); transform: translateY(-8px); box-shadow: 0 15px 35px rgba(0,0,0,0.5), 0 0 15px rgba(159, 85, 255, 0.2); }
  .tech-icon-wrapper { width: 50px; height: 50px; transition: 0.5s; }
  .tech-item:hover .tech-icon-wrapper { transform: scale(1.2) rotate(8deg); }
  .tech-icon-wrapper img { width: 100%; filter: grayscale(0.2); transition: 0.3s; }
  .tech-item:hover img { filter: grayscale(0); }
  .tech-item span { font-size: 0.85rem; color: var(--text-secondary); font-weight: 500; }
  .tech-item:hover span { color: white; }

  /* Education & Certs */
  .dual-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 5rem; }
  .interactive-edu-card { background: var(--card-surface); border: 1px solid var(--border-dim); border-radius: 20px; padding: 2rem; margin-bottom: 1.5rem; transition: 0.3s; }
  .interactive-edu-card:hover { border-color: var(--accent-purple); }
  .edu-header { display: flex; gap: 1.25rem; align-items: center; }
  .edu-logo-small { width: 50px; height: 50px; background: white; border-radius: 10px; padding: 6px; }
  .gpa-tag { font-size: 0.7rem; background: rgba(159, 85, 255, 0.15); color: var(--accent-purple); padding: 4px 10px; border-radius: 6px; font-weight: 800; display: inline-block; margin-top: 8px; }
  .course-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 1.5rem; }
  .course-tag { font-size: 0.75rem; background: #1a1a1a; color: var(--text-secondary); padding: 4px 12px; border-radius: 100px; border: 1px solid var(--border-dim); }
  .edu-period { color: var(--text-secondary); font-size: 0.9rem; margin-top: 1rem; font-weight: 500; }

  .cert-item-minimal { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 2rem; }
  .cert-item-minimal i { font-size: 1.8rem; color: var(--accent-purple); width: 30px; text-align: center; }
  .cert-text h4 { font-size: 1rem; margin: 0; }
  .cert-text p { color: var(--text-secondary); font-size: 0.85rem; margin: 2px 0 0; }

  @media (max-width: 768px) {
    .dual-grid { grid-template-columns: 1fr; }
    .card-header { flex-direction: column; gap: 1rem; }
    .meta { text-align: left; }
    .navbar { top: 1rem; padding: 0.7rem 1.5rem; width: 95%; }
    .content-wrapper { padding-top: 6rem; }
  }
</style>