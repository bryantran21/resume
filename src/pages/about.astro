---
import Layout from '../layouts/Layout.astro';
import BentoCard from '../components/BentoCard.astro';
import BentoGrid from '../components/BentoGrid.astro';
import TravelCard from '../components/TravelCard';

// Bio
const bio = {
  intro: "I’m Bryan, a full-stack developer from New Orleans, Louisiana, interested in building impactful software. I’m currently pursuing my master’s in Computer Science to deepen my technical expertise, while building personal projects that bridge real-world problems with innovative solutions. My goal is to break into finance or healthcare technology, creating software that drives meaningful outcomes for users and organizations alike.",
};
---

<Layout title="About Me - Bryan Tran" description="Learn more about my interests, hobbies, and what I'm into">
  <div class="about-page">


    <div class="content-wrapper">
      <div class="about-hero">
        <h1>About Me</h1>
        <p class="subtitle">This was an excuse to showcase my hobbies</p>
      </div>

      <section class="section bio-section">
        <div class="bio-content">
          <h2 class="section-label">My Story</h2>
          <p class="bio-text">
            I grew up always interested by tech. I went to LSU for my undergrad, and I'm pursuing my Master's at Georgia Tech.
            <br/><br/>
            After my Master's, I'm hoping to gain research experience in AI/ML and pursue either a PhD or gain experience at a big Tech Company!
            <br/><br/>
          </p>
        </div>
      </section>

      <section class="section">
        <BentoGrid>
          <TravelCard client:only="react" />
          
          <BentoCard
            title="Resume Website 📝"
            description="Side project to showcase my skills, projects, and experience."
            size="small"
          />

          <BentoCard title="Sports & Fitness" size="wide">
            <div class="stats-container">
              <div class="stat-item">
                <span class="stat-label">Golf PB</span>
                <span class="stat-value">99</span>
              </div>
              <div class="team-badges">
                <img src="/logos/lsu_sports.png" alt="LSU" />
                <img src="/logos/saints.png" alt="Saints" />
                <img src="/logos/LA_Dodgers.png" alt="Dodgers" />
              </div>
            </div>
          </BentoCard>
        </BentoGrid>
      </section>
    </div>
  </div>
</Layout>

<style>
  :root {
    --bg-main: #000000;
    --card-surface: #111111;
    --border-color: rgba(255, 255, 255, 0.08);
    --text-primary: #ffffff;
    --text-secondary: #888888;
    --accent-purple: #9F55FF; 
  }

  .about-page {
    min-height: 100vh;
    background-color: var(--bg-main);
    color: var(--text-primary);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .content-wrapper {
    padding-top: 8rem;
    padding-bottom: 6rem;
  }

  /* --- NAVBAR --- */
  .navbar {
    position: fixed;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 90%;
    max-width: 850px; 
    padding: 0.8rem 2.5rem;
    background: rgba(10, 10, 10, 0.4);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 100px;
  }

  .logo {
    font-size: 1.1rem;
    font-weight: 800;
    color: white;
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  .nav-links { display: flex; gap: 2rem; }
  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    position: relative;
    padding: 6px 0;
  }
  .nav-link:hover, .nav-link.active { color: white; }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--accent-purple);
    transition: all 0.3s ease;
    transform: translateX(-50%);
    border-radius: 2px;
  }
  .nav-link:hover::after, .nav-link.active::after { width: 100%; }

  /* --- BIO STYLING --- */
  .bio-section {
    margin-bottom: 8rem;
    text-align: left;
  }

  .section-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent-purple);
    margin-bottom: 2rem;
    font-weight: 700;
  }

  .bio-text {
      font-size: 1.15rem; /* Much more reasonable "Pro" size */
      line-height: 1.8;    /* Gives the text room to breathe */
      font-weight: 400;
      color: var(--text-secondary);
      max-width: 750px;   /* Keeps lines from getting too long to read */
      margin-bottom: 2.5rem;
    }

  .purple-glow {
    color: white;
    text-shadow: 0 0 20px rgba(159, 85, 255, 0.5);
    font-weight: 700;
  }

  .text-white { color: white; font-weight: 600; }

  .quick-facts-row { display: flex; flex-wrap: wrap; gap: 1rem; }
  .fact-pill {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    padding: 0.6rem 1.2rem;
    border-radius: 100px;
    font-size: 0.9rem;
    color: var(--text-secondary);
    transition: 0.3s;
  }
  .fact-pill:hover {
    border-color: var(--accent-purple);
    color: white;
    background: rgba(159, 85, 255, 0.1);
    transform: translateY(-2px);
  }

  /* --- HERO & GENERAL --- */
  .about-hero { text-align: center; padding: 4rem 2rem; }
  .about-hero h1 { font-size: clamp(3.5rem, 8vw, 5rem); font-weight: 800; letter-spacing: -0.04em; }
  .about-hero .subtitle { font-size: 1.2rem; color: var(--text-secondary); }
  .section { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }

  @media (max-width: 768px) {
    .navbar { width: 95%; padding: 0.6rem 1.5rem; top: 1rem; }
    .content-wrapper { padding-top: 6rem; }
    .nav-link { font-size: 0.75rem; }
  }
</style>