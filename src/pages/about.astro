---
import Layout from '../layouts/Layout.astro';
import BentoCard from '../components/BentoCard.astro';
import BentoGrid from '../components/BentoGrid.astro';
import TravelCard from '../components/TravelCard';

const bio = {
  intro: "I’m Bryan, a full-stack developer from New Orleans, Louisiana, interested in building impactful software. I’m currently pursuing my master’s in Computer Science to deepen my technical expertise, while building personal projects that bridge real-world problems with innovative solutions.",
};
---

<Layout title="About Me - Bryan Tran" description="Learn more about my interests, hobbies, and what I'm into">
  <div class="about-page">
    <div class="content-wrapper">
      <div class="about-hero">
        <h1>About Me</h1>
        <p class="subtitle">This was an excuse to showcase my hobbies</p>
      </div>

      <section class="section">
        <BentoGrid>
          <BentoCard title="My Story" size="full">
            <div class="bio-text-wrapper">
              <p>
                I grew up always interested by tech. I went to LSU for my undergrad, 
                and I'm pursuing my Master's at Georgia Tech.
              </p>
              <p>
                After my Master's, I'm hoping to gain research experience in AI/ML 
                and pursue either a PhD or gain experience at a big Tech Company!
              </p>
            </div>
          </BentoCard>
          
          <TravelCard client:only="react" />
          
          <BentoCard
            title="Resume Website 📝"
            description="Side project to showcase my skills, projects, and experience."
            size="small"
          />

          <BentoCard title="Sports & Fitness" size="wide">
            <div class="stats-container">
              <div class="stat-item">
                <span class="stat-label">Golf PB</span>
                <span class="stat-value">99</span>
              </div>
              <div class="team-badges">
                <img src="/logos/lsu_sports.png" alt="LSU" />
                <img src="/logos/saints.png" alt="Saints" />
                <img src="/logos/LA_Dodgers.png" alt="Dodgers" />
              </div>
            </div>
          </BentoCard>
        </BentoGrid>
      </section>
    </div>
  </div>
</Layout>

<style>
  .about-page {
    min-height: 100vh;
    background-color: transparent;
    color: var(--text);
    font-family: var(--font-sans);
  }

  .content-wrapper {
    padding-top: 8rem;
    padding-bottom: 6rem;
  }

  /* --- HERO STYLING --- */
  .about-hero {
    text-align: center;
    padding: 4rem 2rem;
  }

  .about-hero h1 {
    font-size: clamp(3.5rem, 8vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .about-hero .subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
  }

  /* --- CONTENT STYLING --- */
  .section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .bio-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    text-align: left;
  }

  /* --- BENTO INTERNAL STYLES --- */
  .stats-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: 1rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-weight: 600;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 600;
  }

  .team-badges {
    display: flex;
    gap: 1rem;
  }

  .team-badges img {
    height: 40px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.6;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  .team-badges img:hover {
    filter: grayscale(0);
    opacity: 1;
  }

  @media (max-width: 768px) {
    .content-wrapper { padding-top: 6rem; }
    .about-hero h1 { font-size: 3.5rem; }
  }
</style>