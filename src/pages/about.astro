---
function setOpen(arg0: boolean) {
throw new Error('Function not implemented.');
}

import Layout from '../layouts/Layout.astro';
import BentoCard from '../components/BentoCard.astro';
import BentoGrid from '../components/BentoGrid.astro';
import GlobeModal from '../components/GlobeModal';
import TravelCard from '../components/TravelCard';

// Bio
const bio = {
  intro: "I’m Bryan, a full-stack developer from New Orleans, Louisiana, interested in building impactful software. I’m currently pursuing my master’s in Computer Science to deepen my technical expertise, while building personal projects that bridge real-world problems with innovative solutions. My goal is to break into finance or healthcare technology, creating software that drives meaningful outcomes for users and organizations alike.",
  quickFacts: [
    "🐯 LSU & ⚜️ Saints Football Fan ",
    "🏌️ Golf enthusiast with a PB of 99",
    "🎬 Movie/Anime & 📖 Manga Enjoyer",
    "🎴 TCG collector (One Piece & Pokémon)",
    "🏋️ Avid lifter & 💪 future bodybuilder",
    "✈️ Traveler &  🍽️ a foodie" 
    ]
};

---

<Layout title="About Me - Bryan Tran" description="Learn more about my interests, hobbies, and what I'm into">
  <div class="about-page">
    <!-- Navbar -->
    <nav class="navbar">
      <a href="/" class="logo">BRYAN</a>
      <div class="nav-links">
        <a href="/about" class="nav-link active">About</a>
        <a href="/resume" class="nav-link">Resume</a>
        <a href="/projects" class="nav-link">Projects</a>
        <a href="#" class="nav-link">Sign In</a>
      </div>
    </nav>

    <!-- Hero -->
    <div class="about-hero">
      <h1>About Me</h1>
      <p class="subtitle">This was an excuse to showcase my hobbies</p>
    </div>

    <!-- Bio Section -->
    <section class="section bio-section">
      <div class="bio-card">
        <p class="bio-intro">{bio.intro}</p>
        <div class="quick-facts">
          {bio.quickFacts.map(fact => (
            <div class="fact-item">{fact}</div>
          ))}
        </div>
      </div>
    </section>
  </div>

  <BentoGrid>

    <BentoCard
      title="Job AI Assistant 🤖"
      description="Resume vs job matching"
      size="wide"
    />

    <TravelCard client:only="react" />

    <BentoCard
      title="LSU Sports Trivia 🏈"
      description="Fun side project"
      size="small"
    />
</BentoGrid>
</Layout>

<style>
  .about-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: white;
    padding-bottom: 4rem;
  }

  /* Bio Section */
  .bio-section {
    margin-bottom: 4rem;
  }

  .bio-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.5rem;
    padding: 2.5rem;
    backdrop-filter: blur(10px);
  }

  .bio-intro {
    font-size: 1.15rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2rem;
  }

  .quick-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  .fact-item {
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.85);
    border-left: 3px solid #60a5fa;
  }

  /* Navbar */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 3rem;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
    border: none;
    outline: none;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 800;
    color: white;
    letter-spacing: 0.05em;
    outline: none;
  }

  .logo:hover {
    opacity: 0.8;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    color: white;
    font-size: 0.95rem;
    font-weight: 400;
    opacity: 0.9;
    transition: opacity 0.2s;
    outline: none;
  }

  .nav-link:hover {
    opacity: 1;
  }

  .nav-link.active {
    opacity: 1;
    border-bottom: 2px solid #60a5fa;
    padding-bottom: 0.25rem;
  }

  /* Hero */
  .about-hero {
    text-align: center;
    padding: 3rem 2rem 4rem;
    max-width: 50rem;
    margin: 0 auto;
  }

  .about-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .about-hero .subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.7);
  }

  /* Sections */
  .section {
    max-width: 70rem;
    margin: 0 auto 5rem;
    padding: 0 2rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
  }

  .section-title i {
    font-size: 1.5rem;
    color: #60a5fa;
  }

  .section-description {
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 2rem;
  }

  .subsection-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 3rem 0 1.5rem;
    color: #60a5fa;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .navbar {
      padding: 1rem 1.5rem;
      flex-direction: column;
      gap: 1rem;
    }

    .nav-links {
      gap: 1rem;
      font-size: 0.85rem;
    }

    .section {
      padding: 0 1.5rem;
    }
  }
</style>