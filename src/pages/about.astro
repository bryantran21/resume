---
import Layout from '../layouts/Layout.astro';
import BentoCard from '../components/BentoCard.astro';
import BentoGrid from '../components/BentoGrid.astro';
import TravelCard from '../components/TravelCard';

// Bio
const bio = {
  intro: "I’m Bryan, a full-stack developer from New Orleans, Louisiana, interested in building impactful software. I’m currently pursuing my master’s in Computer Science to deepen my technical expertise, while building personal projects that bridge real-world problems with innovative solutions. My goal is to break into finance or healthcare technology, creating software that drives meaningful outcomes for users and organizations alike.",
  quickFacts: [
    "🎬 Movie/Anime & 📖 Manga Enjoyer",
    "🎴 TCG collector (One Piece & Pokémon)",
    "🏋️ Avid lifter & 💪 future bodybuilder",
    ]
};
---

<Layout title="About Me - Bryan Tran" description="Learn more about my interests, hobbies, and what I'm into">
  <div class="about-page">
    
    <nav class="navbar">
      <a href="/" class="logo">BRYAN</a>
      <div class="nav-links">
        <a href="/about" class="nav-link active">About</a>
        <a href="/resume" class="nav-link">Resume</a>
        <a href="/projects" class="nav-link">Projects</a>
        <a href="#" class="nav-link">Sign In</a>
      </div>
    </nav>

    <div class="content-wrapper">
      <div class="about-hero">
        <h1>About Me</h1>
        <p class="subtitle">This was an excuse to showcase my hobbies</p>
      </div>

      <section class="section bento-section">
        <BentoGrid>
          <TravelCard client:only="react" />

          <BentoCard
            title="Resume Website 📝"
            description="Side project to showcase my skills, projects, and experience."
            size="small"
          />

          <BentoCard title="Sports & Fitness" size="wide">
            <div class="stats-container">
              <div class="stat-item">
                <span class="stat-label">Golf PB</span>
                <span class="stat-value">99</span>
              </div>
              <div class="team-badges">
                <img src="/logos/lsu_sports.png" alt="LSU" />
                <img src="/logos/saints.png" alt="Saints" />
                <img src="/logos/LA_Dodgers.png" alt="Dodgers" />
              </div>
            </div>
          </BentoCard>
        </BentoGrid>
      </section>
    </div>
  </div>
</Layout>

<style>
  :root {
    --bg-main: #000000;
    --card-surface: #111111;
    --border-color: rgba(255, 255, 255, 0.08);
    --text-primary: #ffffff;
    --text-secondary: #888888;
    --accent-purple: #9F55FF; 
  }

  .about-page {
    min-height: 100vh;
    background-color: var(--bg-main);
    color: var(--text-primary);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  /* WRAPPER TO PUSH CONTENT DOWN */
  .content-wrapper {
    padding-top: 8rem; /* Enough space so the fixed navbar doesn't cover H1 */
    padding-bottom: 6rem;
  }

  /* --- THE GLASS PILL NAVBAR --- */
  .navbar {
    position: fixed;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    
    display: flex;
    justify-content: space-between;
    align-items: center;
    
    /* LOCK THESE TWO VALUES ACROSS ALL FILES */
    width: 90%;
    max-width: 850px; 
    
    padding: 0.8rem 2.5rem;
    
    background: rgba(10, 10, 10, 0.4);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 100px;
  }

  .logo {
    font-size: 1.1rem;
    font-weight: 800;
    color: white;
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.3s ease;
    position: relative;
    padding: 4px 0;
  }

  .nav-link:hover, .nav-link.active {
    color: white;
  }

  /* UNDERLINE ANIMATION (Matches Index) */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--accent-purple);
    transition: all 0.3s ease;
    transform: translateX(-50%);
    border-radius: 2px;
  }

  .nav-link:hover::after, .nav-link.active::after {
    width: 100%;
  }

  /* --- REST OF STYLES --- */
  .about-hero {
    text-align: center;
    padding: 4rem 2rem;
  }

  .about-hero h1 {
    font-size: clamp(3.5rem, 8vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
  }

  .about-hero .subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
  }

  .section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .navbar {
      width: 95%;
      padding: 0.6rem 1.5rem;
      top: 1rem;
    }
    .content-wrapper { padding-top: 6rem; }
    .nav-links { gap: 1rem; }
    .nav-link { font-size: 0.75rem; }
  }
</style>