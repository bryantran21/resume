---
import Layout from '../layouts/Layout.astro';
import BentoCard from '../components/BentoCard.astro';
import BentoGrid from '../components/BentoGrid.astro';
import TravelCard from '../components/TravelCard';

// Bio
const bio = {
  intro: "I’m Bryan, a full-stack developer from New Orleans, Louisiana, interested in building impactful software. I’m currently pursuing my master’s in Computer Science to deepen my technical expertise, while building personal projects that bridge real-world problems with innovative solutions. My goal is to break into finance or healthcare technology, creating software that drives meaningful outcomes for users and organizations alike.",
  quickFacts: [
    "🐯 LSU & ⚜️ Saints Football Fan ",
    "🏌️ Golf enthusiast with a PB of 99",
    "🎬 Movie/Anime & 📖 Manga Enjoyer",
    "🎴 TCG collector (One Piece & Pokémon)",
    "🏋️ Avid lifter & 💪 future bodybuilder",
    "✈️ Traveler & 🍽️ a foodie" 
    ]
};
---

<Layout title="About Me - Bryan Tran" description="Learn more about my interests, hobbies, and what I'm into">
  <div class="about-page">
    
    <nav class="navbar">
      <a href="/" class="logo">BRYAN</a>
      <div class="nav-links">
        <a href="/about" class="nav-link active">About</a>
        <a href="/resume" class="nav-link">Resume</a>
        <a href="/projects" class="nav-link">Projects</a>
        <a href="#" class="nav-link">Sign In</a>
      </div>
    </nav>

    <div class="about-hero">
      <h1>About Me</h1>
      <p class="subtitle">This was an excuse to showcase my hobbies</p>
    </div>

    <section class="section bio-section">
      <div class="bio-card">
        <p class="bio-intro">{bio.intro}</p>
        <div class="quick-facts">
          {bio.quickFacts.map(fact => (
            <div class="fact-item">{fact}</div>
          ))}
        </div>
      </div>
    </section>

    <section class="section bento-section">
      <BentoGrid>
        <TravelCard client:only="react" />

        <BentoCard
          title="Resume Website 📝"
          description="Side project to showcase my skills, projects, and experience."
          size="small"
        />
      </BentoGrid>
    </section>
  </div>
</Layout>

<style>
  /* Root Variables for the Purple Theme */
  :root {
    --bg-main: #000000;
    --card-surface: #111111;
    --card-hover: #161616;
    --border-color: rgba(255, 255, 255, 0.08);
    --text-primary: #ffffff;
    --text-secondary: #888888;
    
    /* Theme Accent: Rich Deep Violet */
    --accent-purple: #9F55FF; 
  }

  /* Global page setup: BLACK and Font Stack */
  .about-page {
    min-height: 100vh;
    background-color: var(--bg-main);
    color: var(--text-primary);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    padding-bottom: 6rem;
  }

  /* Navbar: Sophisticated Dark */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 10%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(20px);
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 0.5px solid var(--border-color);
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .logo:hover { opacity: 0.8; }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.active {
    color: var(--text-primary);
    border-bottom: 1.5px solid var(--accent-purple); /* PURPLE active underline */
    padding-bottom: 0.25rem;
  }

  /* Hero: Bold and Tight */
  .about-hero {
    text-align: center;
    padding: 6rem 2rem 4rem;
    max-width: 50rem;
    margin: 0 auto;
  }

  .about-hero h1 {
    font-size: clamp(3rem, 7vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em; /* Tight letter spacing for that Pro look */
    margin-bottom: 0.75rem;
  }

  .about-hero .subtitle {
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--text-secondary);
  }

  /* Section constraints */
  .section {
    max-width: 70rem;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .bio-section {
    max-width: 900px;
    margin-bottom: 6rem;
  }

  /* Bio Card: Deep Gray Glassmorphism */
  .bio-card {
    background: var(--card-surface);
    border: 1px solid var(--border-color);
    border-radius: 2rem;
    padding: 3.5rem;
    backdrop-filter: blur(10px);
    transition: transform 0.3s ease;
  }

  .bio-intro {
    font-size: 1.25rem;
    line-height: 1.7;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 3rem;
  }

  .quick-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  /* Fact Items: Subtle Purple interaction */
  .fact-item {
    padding: 1.25rem 1.5rem;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 1rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    border-left: 3px solid var(--accent-purple); /* PURPLE border */
    transition: all 0.3s ease;
  }

  .fact-item:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 20px rgba(159, 85, 255, 0.05);
  }

  /* Title styling (retained for consistency, though unused in provided JSX) */
  .subsection-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 3rem 0 1.5rem;
    color: var(--accent-purple); /* PURPLE Subsection titles */
  }

  /* Mobile */
  @media (max-width: 768px) {
    .navbar {
      padding: 1rem 1.5rem;
      flex-direction: column;
      gap: 1rem;
    }

    .logo {
      font-size: 1.1rem;
    }

    .nav-links {
      gap: 1.25rem;
      font-size: 0.8rem;
    }

    .section {
      padding: 0 1.5rem;
    }

    .about-hero {
      padding: 4rem 1.5rem 3rem;
    }

    .bio-card {
      padding: 2rem;
    }

    .bio-intro {
      font-size: 1.1rem;
    }
  }
</style>