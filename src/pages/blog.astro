---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const blogTags = [...new Set(
  sortedPosts.filter(post => (post.data.category || 'blog') === 'blog').flatMap(post => post.data.tags)
)].sort();

const resourceTags = [...new Set(
  sortedPosts.filter(post => post.data.category === 'resources').flatMap(post => post.data.tags)
)].sort();

const title = "Library & Notes";
---

<Layout title={title}>
  <div class="blog-index">
    
    <header class="blog-hero">
      <h1>Library & Notes</h1>
      <p class="subtitle">Documenting the grind and compiling resources.</p>
    </header>

    <div class="filter-controls">
      <div class="category-tabs">
        <button class="tab-btn active" data-category="blog">Blog</button>
        <button class="tab-btn" data-category="resources">Resources</button>
      </div>

      <div class="tag-filters" id="blog-tags">
        {blogTags.map(tag => <button class="tag-pill" data-tag={tag}>#{tag}</button>)}
      </div>

      <div class="tag-filters" id="resource-tags" style="display: none;">
        {resourceTags.map(tag => <button class="tag-pill" data-tag={tag}>#{tag}</button>)}
      </div>
    </div>

    <section class="posts-grid" id="posts-container">
      {sortedPosts.map((post) => {
        const isExternal = !!post.data.link;
        const targetUrl = isExternal ? post.data.link : `/blog/${post.slug}`;
        
        return (
          <div 
            class="post-wrapper" 
            data-category={post.data.category || 'blog'} 
            data-tags={post.data.tags.join(',')}
          >
            <a href={targetUrl} class="post-card" target={isExternal ? "_blank" : "_self"}>
              <div class="card-inner">
                <div class="post-meta">
                  <span class="date">
                    {isExternal ? 'Link' : post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric' })}
                  </span>
                </div>
                <h2 class="post-title">
                  {post.data.title}
                  {isExternal && <i class="fas fa-external-link-alt"></i>}
                </h2>
                <p class="post-description">{post.data.description}</p>
                <div class="tags-row">
                  {post.data.tags.slice(0, 3).map(tag => <span class="mini-tag">#{tag}</span>)}
                </div>
              </div>
            </a>
          </div>
        )
      })}
    </section>
  </div>
</Layout>

<script>
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tagPills = document.querySelectorAll('.tag-pill');
  const posts = document.querySelectorAll('.post-wrapper');
  const container = document.getElementById('posts-container');
  const blogTags = document.getElementById('blog-tags');
  const resTags = document.getElementById('resource-tags');

  let activeCategory = 'blog';
  let activeTag = null;

  function filterPosts() {
    // Toggle Grid Layout
    if (activeCategory === 'resources') {
      container.classList.add('compact-grid');
    } else {
      container.classList.remove('compact-grid');
    }

    posts.forEach(post => {
      const category = post.getAttribute('data-category');
      const tags = post.getAttribute('data-tags').split(',');
      const categoryMatch = category === activeCategory;
      const tagMatch = !activeTag || tags.includes(activeTag);

      if (categoryMatch && tagMatch) {
        post.classList.remove('hidden');
      } else {
        post.classList.add('hidden');
      }
    });
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.getAttribute('data-category');
      
      blogTags.style.display = activeCategory === 'blog' ? 'flex' : 'none';
      resTags.style.display = activeCategory === 'resources' ? 'flex' : 'none';

      activeTag = null;
      tagPills.forEach(p => p.classList.remove('active'));
      filterPosts();
    });
  });

  tagPills.forEach(pill => {
    pill.addEventListener('click', () => {
      const isActive = pill.classList.contains('active');
      tagPills.forEach(p => p.classList.remove('active'));
      if (!isActive) {
        pill.classList.add('active');
        activeTag = pill.getAttribute('data-tag');
      } else {
        activeTag = null;
      }
      filterPosts();
    });
  });

  filterPosts();
</script>

<style>
  .blog-index { max-width: 1000px; margin: 0 auto; padding: 2rem 0 5rem; }
  .blog-hero { margin-bottom: 2.5rem; }
  .blog-hero h1 { font-family: var(--font-mono); font-size: 2.6rem; font-weight: 700; letter-spacing: -0.02em; color: var(--text); }
  .subtitle { color: var(--muted); font-size: 0.95rem; margin-top: 4px; }

  .filter-controls { margin-bottom: 3rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .category-tabs { display: flex; gap: 0.5rem; background: var(--surface); padding: 0.4rem; border-radius: var(--radius-pill); width: fit-content; border: 1px solid var(--border); }
  .tab-btn { padding: 0.6rem 1.2rem; border-radius: var(--radius-pill); border: none; background: transparent; color: var(--text-secondary); font-size: 0.75rem; font-weight: 600; cursor: pointer; text-transform: uppercase; }
  .tab-btn.active { background: var(--btn-bg); color: var(--btn-fg); }

  .tag-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag-pill { background: var(--surface); border: 1px solid var(--border); color: var(--text-secondary); padding: 0.3rem 0.8rem; border-radius: var(--radius-pill); font-size: 0.7rem; font-weight: 500; cursor: pointer; }
  .tag-pill.active { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }

  /* Grid Logic */
  .posts-grid { display: flex; flex-direction: column; gap: 1.5rem; transition: all 0.3s ease; }
  .posts-grid.compact-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }

  .post-wrapper.hidden { display: none; }

  .post-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 1.5rem;
    text-decoration: none;
    display: block;
    height: 100%;
    transition: border-color 0.2s ease;
  }

  .post-card:hover { border-color: var(--border-strong); }

  .post-title { font-size: 1.25rem; font-weight: 600; color: var(--text); margin-bottom: 0.5rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .post-title i { font-size: 0.7rem; opacity: 0.4; }

  .post-description { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .post-meta { margin-bottom: 0.5rem; }
  .date { font-size: 0.65rem; color: var(--accent); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }

  .tags-row { display: flex; gap: 0.5rem; }
  .mini-tag { font-size: 0.65rem; color: var(--text-muted); font-weight: 500; }

  @media (max-width: 768px) {
    .blog-index { padding-top: 6rem; }
    .posts-grid.compact-grid { grid-template-columns: 1fr; }
  }
</style>