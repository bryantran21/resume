---
import Layout from '../layouts/Layout.astro';

// Bryan's "lore" — a life FAQ. Edit answers freely; add/remove questions per group.
// Answers marked TODO are placeholders waiting on Bryan.
const lore = [
  {
    group: 'LIFE',
    items: [
      {
        q: 'so tell me about yourself',
        a: "Hi! I'm Bryan, a CS student at GTech and a developer at IBM. Most of my time goes into the gym, work, and playing games. Otherwise, I'm reading manga / manhua / manhwa, comics, or vibecoding an app I might actually use.",
      },
      {
        q: 'why computer science?',
        a: "Honestly, a YouTuber named Jarvis Johnson got me into it. It was between med school and tech, and I didn't think I was cut out for med school — so CS it was. Before college I did a lot of self-learning, mostly Python since I heard it was the easiest to pick up.",
      },
      { q: 'where do you see yourself in 5 years?', a: 'Hopefully at a nice big-tech job.' },
      {
        q: 'what do you do for fun?',
        a: 'Side projects, games, reading, and watching movies.',
      },
    ],
  },
  {
    group: 'GAMING',
    items: [
      {
        q: 'what do you play?',
        a: 'Practically most PC games.',
      },
    ],
  },
  {
    group: 'BUILDING',
    items: [
      {
        q: 'how do you learn new stuff?',
        a: "I map out a concept with AI, then have it teach me through interactive questions — it introduces the idea and I go do my own research to go deeper whenever something interests me.",
      },
    ],
  },
  {
    group: 'RANDOM',
    items: [
      {
        q: "what's your favorite movie?",
        a: 'A few: Whiplash, The Odyssey, Good Will Hunting, and La La Land.',
      },
      {
        q: 'favorite manga / anime?',
        a: 'One Piece, ifykyk.',
      },
      {
        q: "what's your gym split?",
        a: '5 days a week — Upper, Lower, Push, Pull, Legs. Lowkey SBL.',
      },
      {
        q: "what's your typing speed?",
        a: 'Around 110 wpm — though not consistently 😅',
      },
    ],
  },
];
---

<Layout title="Bryan Tran | Lore" description="Bryan's life FAQ">
  <section class="lore-page">
    <h1 class="lore-title">Lore</h1>
    <p class="lore-sub">(my life's FAQs — ask me anything, these are the ones people actually ask)</p>

    {lore.map(group => (
      <div class="lore-group">
        <h2 class="lore-cat">{group.group}</h2>
        <div class="lore-list">
          {group.items.map(item => (
            <details class="lore-item">
              <summary>
                <span class="lore-q">{item.q}</span>
                <span class="lore-plus">+</span>
              </summary>
              <div class="lore-a">{item.a === 'TODO' ? '…coming soon' : item.a}</div>
            </details>
          ))}
        </div>
      </div>
    ))}

    <a class="lore-back" href="/">← back home</a>
  </section>
</Layout>

<style>
  .lore-page { max-width: 760px; margin: 0 auto; padding: 2rem 0 4rem; }
  .lore-title { font-family: var(--font-mono); font-size: 2.6rem; font-weight: 700; letter-spacing: -0.02em; }
  .lore-sub { color: var(--muted); font-size: 0.95rem; margin: 4px 0 2.5rem; }

  .lore-group { margin-bottom: 2.5rem; }
  .lore-cat { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.12em; color: var(--muted); font-weight: 600; margin-bottom: 12px; }
  .lore-list { display: flex; flex-direction: column; gap: 12px; }

  .lore-item {
    background: var(--panel); border: 1px solid var(--line);
    box-shadow: 4px 4px 0 0 var(--shadow);
  }
  .lore-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 14px 18px; cursor: pointer; list-style: none;
  }
  .lore-item summary::-webkit-details-marker { display: none; }
  .lore-q { font-weight: 600; font-size: 1rem; }
  .lore-plus { font-family: var(--font-mono); font-size: 1.3rem; color: var(--muted); transition: transform 0.15s ease; }
  .lore-item[open] .lore-plus { transform: rotate(45deg); }
  .lore-a { padding: 0 18px 16px; color: var(--muted); line-height: 1.65; }

  .lore-back { display: inline-block; margin-top: 1rem; font-family: var(--font-mono); font-size: 0.85rem; color: var(--text); text-decoration: underline; }
</style>
