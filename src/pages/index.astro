---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import BentoCard from '../components/BentoCard.astro';
import BentoGrid from '../components/BentoGrid.astro';
import TravelCard from '../components/TravelCard';

const name = "BRYAN";
const tagline = "The future belongs to those who believe in the possibilities of tomorrow.";

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/bryantran21', icon: 'fab fa-github' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/bryan-huy-tran', icon: 'fab fa-linkedin' },
  { label: 'Twitter', href: 'https://twitter.com/bryantran21', icon: 'fab fa-twitter' },
  { label: 'Instagram', href: 'https://instagram.com/bryan.tran', icon: 'fab fa-instagram' },
  { label: 'Email', href: 'mailto:bryantran21@gmail.com', icon: 'fas fa-envelope' },
];

const devicon = (slug: string, variant = 'original') =>
  `https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${slug}/${slug}-${variant}.svg`;

const techCategories = [
  {
    name: 'Frontend',
    items: [
      { name: 'React', icon: devicon('react') },
      { name: 'Angular', icon: devicon('angular') },
      { name: 'Next.js', icon: devicon('nextjs') },
      { name: 'TypeScript', icon: devicon('typescript') },
      { name: 'Tailwind', icon: devicon('tailwindcss') },
      { name: 'Astro', icon: devicon('astro') },
      { name: 'Bootstrap', icon: devicon('bootstrap') },
      { name: 'HTML5', icon: devicon('html5') },
      { name: 'CSS3', icon: devicon('css3') },
    ]
  },
  {
    name: 'Backend & Database',
    items: [
      { name: 'Java', icon: devicon('java') },
      { name: 'Spring Boot', icon: devicon('spring') },
      { name: 'Node.js', icon: devicon('nodejs') },
      { name: 'Python', icon: devicon('python') },
      { name: 'MySQL', icon: devicon('mysql') },
      { name: 'MongoDB', icon: devicon('mongodb') },
      { name: 'C#', icon: devicon('csharp') },
      { name: 'PHP', icon: devicon('php') },
      { name: 'Oracle', icon: devicon('oracle') },
    ]
  },
  {
    name: 'DevOps & Tools',
    items: [
      { name: 'AWS', icon: devicon('amazonwebservices', 'plain-wordmark') },
      { name: 'Azure', icon: devicon('azure') },
      { name: 'Docker', icon: devicon('docker') },
      { name: 'Git', icon: devicon('git') },
      { name: 'Jira', icon: devicon('jira') },
      { name: 'Maven', icon: devicon('maven') },
      { name: 'VS Code', icon: devicon('vscode') },
      { name: 'Figma', icon: devicon('figma') },
    ]
  }
];

const experiences = [
  {
    company: 'IBM',
    logo: '/logos/ibm.jpg',
    role: 'Application Developer',
    location: 'Baton Rouge, LA',
    period: 'June 2023 - Present',
    achievements: [
      'Managed Help Desk tickets using Jira, streamlining issue tracking and communication between developers and end users',
      'Spearheaded the integration of Zephyr for Jira to standardize and document QA test cases for new ADE features',
      'Initiated migration from IL2 to IL4, helping leadership align on long-term security and compliance goals',
      'Built a Helpdesk Documentation tab within the internal "Helpdesk Toolbox" to centralize SOPs, troubleshooting steps, and triage workflows',
      'Developed Angular pages with TypeScript featuring role-based access control and reusable UI components',
      'Created detailed wireframes of legacy applications to guide modernization efforts',
      'Developed backend services in Java with 90%+ code coverage using Mockito'
    ]
  },
  {
    company: 'LSU Information Technology Services',
    logo: '/logos/lsu.jpg',
    role: 'Student Web Developer',
    location: 'Baton Rouge, LA',
    period: 'May 2022 - May 2023',
    achievements: [
        "Diagnosed and resolved application crashes through log analysis and DevOps tooling",
        "Remodeled LSU's applications for WCAG accessibility using WAVE, HTML, and CSS",
        "Migrated Java applications to Spring Boot by resolving complex Maven dependency conflicts"
    ]
  },
  {
    company: 'TAG Data Solutions',
    logo: '/logos/tag.jpg',
    role: 'Full Stack Web Developer',
    location: 'Remote',
    period: 'January 2022 - May 2022',
    achievements: [
      'Conceptualized custom software functionality for laboratory animal clinics',
      'Developed user interfaces using standard HTML/CSS/PHP/Javascript practices',
      'Designed relational database schemas and applied front-end requirements via BackboneJS'
    ]
  },
  {
    company: 'MAPP',
    logo: '/logos/mapp.jpg',
    role: 'IT Intern',
    location: 'Baton Rouge, LA',
    period: 'March 2021 - Dec 2021',
    achievements: [
      'Provided technical support and hardware configuration for cross-departmental users',
      "Architected Power BI dashboards to visualize contract growth and bid data",
      'Built internal workflow applications using the Microsoft Power Platform',
      'Managed enterprise user data and security protocols as an IT Administrator'
    ]
  }
];

const education = [
  {
    school: 'Georgia Tech',
    logo: '/logos/gatech.png',
    degree: 'MS Computer Science',
    period: 'Aug 2026 - Present',
    gpa: 'n/a',
    coursework: ['Graduate Algorithms', 'Machine Learning', 'Software Architecture', 'Info Security']
  },
  {
    school: 'Louisiana State University',
    logo: '/logos/lsu.jpg',
    degree: 'BS Computer Science',
    period: 'Aug 2019 - May 2023',
    gpa: '3.4',
    coursework: ['Data Structures', 'Operating Systems', 'Database Management', 'Cloud Computing', 'Cybersecurity']
  }
];

const certificates = [
  { name: 'AWS Cloud Practitioner', issuer: 'Amazon', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/amazonwebservices/amazonwebservices-original-wordmark.svg' },
  { name: 'Azure Fundamentals', issuer: 'Microsoft', logo: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/azure/azure-original.svg' },
  { name: 'Security Clearance: Secret', issuer: 'US Navy', icon: 'fas fa-shield-alt' },
  { name: 'Foundational C#', issuer: 'Microsoft', logo: 'https://upload.wikimedia.org/wikipedia/commons/thumb/4/44/Microsoft_logo.svg/960px-Microsoft_logo.svg.png?_=20210729021049' },
];

const projects = [
  {
    id: 'resume',
    title: 'Personal Resume Website',
    description: 'A modern, interactive portfolio engineered to showcase technical depth. Built with a focus on high-performance SSR and custom-engineered UI components without the crutch of CSS frameworks.',
    tech: ['Astro', 'TypeScript', 'CSS', 'Node.js'],
    category: 'Interface Engineering',
    liveUrl: 'https://bhtran.com',
    githubUrl: 'https://github.com/bryantran21/resume',
    featured: true,
  },
  {
    id: 'iron-log',
    title: 'Iron Log',
    description: 'A high-performance fitness synchronization engine designed for mobile-first progressive overload tracking. Engineered with a focus on data integrity, real-time volume scoring, and an adaptive training split architecture.',
    tech: ['Next.js 14', 'Supabase SSR', 'TypeScript', 'Tailwind CSS', 'Framer Motion'],
    category: 'Systems Engineering',
    liveUrl: 'https://gym.bhtran.com',
    githubUrl: 'https://github.com/bryantran21/fitness-tracker',
    featured: true,
  },
  {
    id: 'rote',
    title: 'Rote',
    description: 'A spaced-repetition engine that drills Python syntax for coding interviews. Built on a Leitner scheduler and a local-first persistence layer — no accounts, no backend, every rep held in the browser.',
    tech: ['Next.js', 'TypeScript', 'Tailwind CSS', 'Dexie', 'Zustand'],
    category: 'Learning Systems',
    liveUrl: 'https://rote.bhtran.com',
    githubUrl: 'https://github.com/bryantran21/rote',
    featured: true,
  },
  {
    id: 'quantdrill',
    title: 'QuantDrill',
    description: 'Randomized, timed practice for the aptitude assessments prop trading firms screen interns with — sequences, fast probability, orderbook arbitrage, and reflex games. Every generator is exact and every board brute-forced, so grading is unambiguous. Runs entirely in the browser.',
    tech: ['React 19', 'Vite', 'TypeScript', 'Tailwind CSS', 'Vitest'],
    category: 'Quant Tooling',
    liveUrl: 'https://quant.bhtran.com',
    githubUrl: 'https://github.com/bryantran21/quantdrill',
    featured: true,
  }
];
---

<Layout title={name} description="Personal website and portfolio">
  <div class="hero-section">
    <div class="hero">
      <div class="profile-island">
        <img
          src="/profile.jpg"
          alt="Profile photo"
          class="profile-photo"
          id="profile-photo"
        />
      </div>

      <h1 class="name">{name}</h1>
      <p class="tagline">{tagline}</p>

      <div class="social-links">
        {socialLinks.map(link => (
          <a
            href={link.href}
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class={link.icon}></i>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <div id="about" class="page-block alt">
    <div class="about-hero">
      <h1>About Me</h1>
      <p class="subtitle">This was an excuse to showcase my hobbies</p>
    </div>

    <section class="about-content">
      <BentoGrid>
        <BentoCard title="My Story" size="full">
          <div class="bio-text-wrapper">
            <p>
              I grew up always interested by tech. I went to LSU for my undergrad,
              and I'm pursuing my Master's at Georgia Tech.
            </p>
            <p>
              After my Master's, I'm hoping to gain research experience in AI/ML
              and pursue either a PhD or gain experience at a big Tech Company!
            </p>
          </div>
        </BentoCard>

        <TravelCard client:only="react" />

        <BentoCard
          title="Resume Website 📝"
          description="Side project to showcase my skills, projects, and experience."
          size="small"
        />

        <BentoCard title="Sports & Fitness" size="wide">
          <div class="stats-container">
            <div class="stat-item">
              <span class="stat-label">Golf PB</span>
              <span class="stat-value">99</span>
            </div>
            <div class="team-badges">
              <img src="/logos/lsu_sports.png" alt="LSU" />
              <img src="/logos/saints.png" alt="Saints" />
              <img src="/logos/LA_Dodgers.png" alt="Dodgers" />
            </div>
          </div>
        </BentoCard>
      </BentoGrid>
    </section>
  </div>

  <div class="divider"></div>

  <div id="resume" class="page-block">
    <div class="resume-hero">
      <h1>Resume</h1>
      <p class="subtitle">Full Stack Developer & Problem Solver</p>
      <a href="/Bryan_Tran_Resume.pdf" target="_blank" rel="noopener noreferrer" class="download-btn">
        <i class="fas fa-download"></i>
        Download PDF
      </a>
    </div>

    <section class="resume-section">
      <SectionLabel num="01" label="Experience" />
      <div class="timeline">
        {experiences.map(exp => (
          <div class="experience-card">
            <div class="card-header">
              <div class="company-info">
                <div class="logo-wrapper"><img src={exp.logo} alt={exp.company} class="company-logo" /></div>
                <div>
                  <h3>{exp.role}</h3>
                  <p class="company-name">{exp.company}</p>
                </div>
              </div>
              <div class="meta">
                <p class="period">{exp.period}</p>
                <p class="location">{exp.location}</p>
              </div>
            </div>
            <ul class="achievements">
              {exp.achievements.map(achievement => <li>{achievement}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="resume-section dual-grid">
      <div class="edu-column">
        <SectionLabel num="02" label="Education" />
        <div class="edu-list">
          {education.map(edu => (
            <div class="interactive-edu-card">
              <div class="edu-header">
                  <img src={edu.logo} alt={edu.school} class="edu-logo-small" />
                  <div class="edu-info">
                    <h3>{edu.school}</h3>
                    <p>{edu.degree} <span class="gpa-tag">GPA {edu.gpa}</span></p>
                  </div>
              </div>
              <div class="edu-details">
                <p class="edu-period">{edu.period}</p>
                <div class="course-list">
                    {edu.coursework.map(course => <span class="course-tag">{course}</span>)}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="cert-column">
        <SectionLabel num="03" label="Certifications" />
        <div class="cert-list">
          {certificates.map(cert => (
            <div class="cert-item-minimal">
              <div class="cert-icon-box">
                {cert.logo ? (
                  <img src={cert.logo} alt={cert.name} class="cert-img" />
                ) : (
                  <i class={cert.icon}></i>
                )}
              </div>
              <div class="cert-text">
                <h4>{cert.name}</h4>
                <p>{cert.issuer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="resume-section">
      <SectionLabel num="04" label="Technical arsenal" />

      {techCategories.map(cat => (
        <div class="tech-category">
          <h3 class="tech-category-title">{cat.name}</h3>
          <div class="tech-marquee">
            <div class="tech-track">
              {[...cat.items, ...cat.items].map(tech => (
                <div class="tech-item">
                  <div class="tech-icon-wrapper"><img src={tech.icon} alt={tech.name} /></div>
                  <span>{tech.name}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </section>
  </div>

  <div class="divider"></div>

  <div id="projects" class="page-block alt">
    <div class="projects-hero">
      <h1>Projects</h1>
      <p class="subtitle">A collection of systems, experiments, and research notes. 🚧 Currently expanding.</p>
    </div>

    <section class="projects-section">
      <div class="projects-grid">
        {projects.map(project => (
          <div class="project-card">
            <div class="project-image">
              {project.id === 'iron-log' ? (
                <div class="heatmap-container">
                  <div class="heatmap-grid">
                    {Array.from({ length: 40 }).map((_, i) => (
                      <div class={`heat-tile level-${(i % 7 === 0 || i % 5 === 0) ? Math.floor(Math.random() * 3) + 1 : 0}`}></div>
                    ))}
                  </div>
                  <div class="heatmap-label">ACTIVITY_METRIC_v2.0</div>
                </div>
              ) : project.id === 'rote' ? (
                <div class="leitner-container">
                  <div class="leitner-row">
                    {[
                      { day: 0, fill: 5 },
                      { day: 1, fill: 4 },
                      { day: 3, fill: 3 },
                      { day: 7, fill: 2 },
                      { day: 16, fill: 1 },
                    ].map((box, i) => (
                      <div class="leitner-box">
                        <div class={`leitner-stack ${i === 2 ? 'active' : ''}`}>
                          {Array.from({ length: box.fill }).map(() => (
                            <div class="leitner-card"></div>
                          ))}
                        </div>
                        <span class="leitner-day">{box.day}d</span>
                      </div>
                    ))}
                  </div>
                  <div class="tile-label">LEITNER_SR_5BOX</div>
                </div>
              ) : project.id === 'quantdrill' ? (
                <div class="seq-container">
                  <div class="seq-row">
                    {['2', '6', '14', '30'].map(term => (
                      <span class="seq-term">{term}</span>
                    ))}
                    <span class="seq-term blank">?</span>
                  </div>
                  <div class="tile-label">SEQ_SOLVER_v1</div>
                </div>
              ) : (
                <div class="image-placeholder"></div>
              )}
              <div class="project-category">{project.category}</div>
            </div>

            <div class="project-content">
              <h3>{project.title}</h3>
              <p class="project-description">{project.description}</p>

              <div class="tech-stack">
                {project.tech.map(tech => (
                  <span class="tech-badge">{tech}</span>
                ))}
              </div>

              <div class="project-links">
                <a href={project.liveUrl} target="_blank" class="project-btn primary">
                  <i class="fas fa-external-link-alt"></i>
                  Live View
                </a>
                <a href={project.githubUrl} target="_blank" class="project-btn secondary">
                  <i class="fab fa-github"></i>
                  Source
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="cta-section">
      <div class="cta-glass">
        <h2>Interested in Research?</h2>
        <p>I'm looking for opportunities to collaborate on AI/ML projects or Big Tech roles.</p>
        <div class="cta-buttons">
          <a href="mailto:bryantran21@gmail.com" class="cta-btn">
            <i class="fas fa-envelope"></i>
            Contact Me
          </a>
          <a href="https://github.com/bryantran21" target="_blank" class="cta-btn secondary">
            <i class="fab fa-github"></i>
            Open GitHub
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Shared page-block rhythm for About / Resume / Projects */
  .page-block {
    padding: 6rem 0;
    scroll-margin-top: 110px;
  }

  .page-block.alt {
    background: var(--bg-alt);
  }

  .divider {
    width: 100%;
    height: 1px;
    background: var(--border);
  }

  /* ---------- Hero ---------- */
  .hero-section { position: relative; }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 78vh;
    padding: 5rem 2rem;
  }

  .profile-photo {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    border: 3px solid var(--border);
    object-fit: cover;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .profile-photo:hover {
    border-color: var(--accent);
  }

  .name {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-top: 0.75rem;
  }

  .tagline {
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-weight: 400;
    max-width: 35rem;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
    text-wrap: balance;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    color: var(--text);
    padding: 0.8rem 1.2rem;
    background: var(--surface);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    transition: border-color 0.2s ease, background 0.2s ease;
    text-decoration: none !important;
  }

  .social-link:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .spinning {
    animation: spin360 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes spin360 {
    from { transform: rotate(0deg) }
    to { transform: rotate(360deg) }
  }

  /* ---------- About ---------- */
  .about-hero { text-align: center; padding: 0 2rem 3rem; }
  .about-hero h1 { font-size: clamp(3rem, 7vw, 4.5rem); font-weight: 600; letter-spacing: -0.03em; margin-bottom: 0.5rem; }
  .about-hero .subtitle { font-size: 1.2rem; color: var(--text-secondary); }

  .about-content { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }

  .bio-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    text-align: left;
  }

  .stats-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: 1rem;
  }

  .stat-item { display: flex; flex-direction: column; gap: 0.2rem; }
  .stat-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); font-weight: 600; }
  .stat-value { font-size: 2rem; font-weight: 600; }

  .team-badges { display: flex; gap: 1rem; }
  .team-badges img {
    height: 40px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.6;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }
  .team-badges img:hover { filter: grayscale(0); opacity: 1; }

  /* ---------- Resume ---------- */
  .resume-hero { text-align: center; padding: 0 2rem 3rem; }
  .resume-hero h1 { font-size: clamp(3rem, 7vw, 4.5rem); font-weight: 600; letter-spacing: -0.03em; margin-bottom: 1rem; }
  .resume-hero .subtitle { font-size: 1.5rem; color: var(--text-secondary); margin-bottom: 2.5rem; }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2.5rem;
    background: var(--btn-bg);
    color: var(--btn-fg);
    border-radius: var(--radius-pill);
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .download-btn:hover { opacity: 0.85; }

  .resume-section { max-width: 1000px; margin: 0 auto 6rem; padding: 0 2rem; }

  .experience-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 3rem;
    margin-bottom: 2rem;
    transition: border-color 0.2s ease;
  }
  .experience-card:hover { border-color: var(--border-strong); }
  .card-header { display: flex; justify-content: space-between; margin-bottom: 2.5rem; }
  .logo-wrapper { width: 54px; height: 54px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; display: flex; align-items: center; justify-content: center; padding: 6px; }
  .company-logo { width: 100%; height: auto; object-fit: contain; }
  .company-info { display: flex; gap: 1.5rem; align-items: center; }
  .company-info h3 { font-size: 1.6rem; font-weight: 600; margin: 0; letter-spacing: -0.01em; }
  .company-name { color: var(--accent); font-weight: 500; font-size: 1.1rem; margin-top: 4px; }
  .meta { text-align: right; }
  .period { font-weight: 500; margin: 0; }
  .location { color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px; }
  .achievements { list-style: none; padding: 0; }
  .achievements li { color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.7; padding-left: 1.5rem; position: relative; font-size: 1.05rem; }
  .achievements li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }

  /* Tech Marquee */
  .tech-category-title { color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem; text-transform: uppercase; }
  .tech-category { margin-bottom: 2.5rem; }

  .tech-marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }

  .tech-track {
    display: flex;
    width: max-content;
    gap: 1.25rem;
    animation: tech-scroll 32s linear infinite;
  }

  .tech-category:nth-of-type(2) .tech-track { animation-duration: 38s; animation-direction: reverse; }
  .tech-category:nth-of-type(3) .tech-track { animation-duration: 26s; }

  .tech-marquee:hover .tech-track { animation-play-state: paused; }

  @keyframes tech-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .tech-item {
    flex: 0 0 auto;
    width: 120px;
    background: var(--surface);
