---

<Layout title={name} description="Bryan Tran — Application Developer & CS Master's student">
  <!-- ============ INTRO ============ -->
  <section class="intro-box">
    <div class="intro-text">
      <p class="intro-lead">
        Hi! I'm Bryan, a CS student at <strong>GTech</strong> and a Developer for <strong>IBM</strong>.
      </p>
      <p>Most of my time goes into software, playing video games, and going to the gym.</p>
      <p>
        Feel free to reach out to me on
        <a href="https://linkedin.com/in/bryan-huy-tran" target="_blank" rel="noopener" class="inline-link">LinkedIn</a>.
      </p>
      <div class="intro-socials">
        {socialLinks.map(link => (
          <a class="btn btn-icon social" href={link.href} target="_blank" rel="noopener" aria-label={link.label} style={`--brand:${link.brand}`}>
            <i class={link.icon}></i>
          </a>
        ))}
      </div>
    </div>
    <div class="intro-photo-wrap">
      <img class="intro-photo" src="/headshot.jpg" alt="Bryan Tran" />
    </div>
  </section>

  <!-- ============ ABOUT / HOBBIES ============ -->
  <h2 id="about" class="sec-head">About</h2>
  <p class="sec-sub">An excuse to show off some hobbies.</p>
  <div class="about-grid">
    <BentoGrid>
      <BentoCard title="Read my Blog ✍️" description="Thoughts, resources, and school notes →" size="small" href="/blog" />

      <BentoCard title="Lore 😛" description="My life's FAQs — the questions people actually ask →" size="small" href="/lore" />

      <BentoCard title="Sports & Fitness" size="wide">
        <div class="stats-container">
          <div class="stat-item">
            <span class="stat-label">Golf PB</span>
            <span class="stat-value">99</span>
          </div>
          <div class="team-badges">
            <img src="/logos/lsu_sports.png" alt="LSU" />
            <img src="/logos/saints.png" alt="Saints" />
            <img src="/logos/LA_Dodgers.png" alt="Dodgers" />
          </div>
        </div>
      </BentoCard>

      <div class="travel-cell"><TravelCard client:only="react" /></div>

      <a class="tft-card" href={tft.trackerUrl} target="_blank" rel="noopener">
        <div class="tft-head">
          <h3>TFT · Ranked</h3>
          <span class="tft-id">{tft.riotId}</span>
        </div>
        <div class="tft-hero">
          <div class="tft-emblem"><img src={tft.emblem} alt="Emerald rank emblem" /></div>
          <div class="tft-hero-text">
            <span class="tft-label">All-Time Best</span>
            <span class="tft-tier">{tft.peak.tier}</span>
            <span class="tft-lp">{tft.peak.lp} LP</span>
          </div>
        </div>
        <div class="tft-prev">
          <span class="tft-prev-label">Previous</span>
          {tft.previous.map(p => (
            <span class="tft-chip">{p.season} <strong>{p.rank}</strong></span>
          ))}
        </div>
      </a>

      <div class="yt-card">
        <h3>Straight from my Top 50 🎵</h3>
        <p class="yt-sub">A random pick every time you visit</p>
        <div class="yt-frame"><div id="yt-player"></div></div>
      </div>

      <div class="games-card">
        <div class="games-list">
          {games.map(g => (
            <a class="game-row" href={g.url} target="_blank" rel="noopener">
              <img class="game-emblem" src={g.emblem} alt={`${g.name} ${g.rank}`} />
              <span class="game-name">{g.name}</span>
            </a>
          ))}
        </div>
        <div class="games-hero jett" role="img" aria-label="Jett — Valorant"></div>
        <img class="games-hero psylocke" src="/logos/psylocke.webp" alt="Psylocke — Marvel Rivals" />
      </div>

      <div class="lbxd-card">
        <div class="lbxd-head">
          <h3>Recently Watched 🎬</h3>
          <a href="https://letterboxd.com/bryantran21/" target="_blank" rel="noopener" class="lbxd-more">Letterboxd →</a>
        </div>
        <div class="lbxd-strip">
          {films.map(film => (
            <a class="lbxd-film" href={film.link} target="_blank" rel="noopener" title={`${film.title} (${film.year})${film.rating ? ` — ${film.rating}★` : ''}`}>
              <img src={film.poster} alt={film.title} loading="lazy" />
              {film.rating && <span class="lbxd-rating">{film.rating}★</span>}
            </a>
          ))}
        </div>
      </div>
    </BentoGrid>

    <script is:inline>
      (function () {
        var PLAYLIST = 'PLL1X_M4rQTFo';
        window.onYouTubeIframeAPIReady = function () {
          new YT.Player('yt-player', {
            playerVars: { listType: 'playlist', list: PLAYLIST, rel: 0, modestbranding: 1 },
            events: {
              onReady: function (e) {
                var list = e.target.getPlaylist();
                if (list && list.length) {
                  e.target.setShuffle(true);
                  e.target.cuePlaylist({ listType: 'playlist', list: PLAYLIST, index: Math.floor(Math.random() * list.length) });
                }
              },
            },
          });
        };
        var tag = document.createElement('script');
        tag.src = 'https://www.youtube.com/iframe_api';
        document.head.appendChild(tag);
      })();
    </script>
  </div>

  <!-- ============ PHOTOS ============ -->
  <h2 id="photos" class="sec-head">Photos</h2>
  <p class="sec-sub">Travel, film, and everything in between.</p>
  <div class="photo-grid">
    {photos.map(photo => (
      <figure class="photo-item">
        <img src={photo.src} alt={photo.caption || 'Photo'} loading="lazy" />
        {photo.caption && <figcaption class="photo-cap">{photo.caption}</figcaption>}
      </figure>
    ))}
  </div>

  <!-- ============ RESUME ============ -->
  <h2 id="resume" class="sec-head">Resume</h2>
  <div class="resume-top">
    <p class="sec-sub">Full-stack developer &amp; problem solver.</p>
    <a class="btn" href="/Bryan_Tran_Resume.pdf" target="_blank" rel="noopener">
      <i class="fas fa-download"></i><span>Download PDF</span>
    </a>
  </div>

  <h3 class="mini-label">// experience</h3>
  <div class="timeline">
    {experiences.map(exp => (
      <div class="experience-card">
        <div class="card-header">
          <div class="company-info">
            <div class="logo-wrapper"><img src={exp.logo} alt={exp.company} class="company-logo" /></div>
            <div>
              <h3>{exp.role}</h3>
              <p class="company-name">{exp.company}</p>
            </div>
          </div>
          <div class="meta">
            <p class="period">{exp.period}</p>
            <p class="location">{exp.location}</p>
          </div>
        </div>
        <ul class="achievements">
          {exp.achievements.map(a => <li>{a}</li>)}
        </ul>
        {exp.pictures && exp.pictures.length > 0 && (
          <details class="exp-pics">
            <summary><i class="fas fa-images"></i> pictures</summary>
            <div class="exp-pics-row">
              {exp.pictures.map(src => <img src={src} alt="" loading="lazy" />)}
            </div>
          </details>
        )}
      </div>
    ))}
  </div>

  <div class="dual-grid">
    <div>
      <h3 class="mini-label">// education</h3>
      <div class="edu-list">
        {education.map(edu => (
          <div class="interactive-edu-card">
            <div class="edu-header">
              <img src={edu.logo} alt={edu.school} class="edu-logo-small" />
              <div class="edu-info">
                <h3>{edu.school}</h3>
                <p>{edu.degree} <span class="gpa-tag">GPA {edu.gpa}</span></p>
              </div>
            </div>
            <p class="edu-period">{edu.period}</p>
            <div class="course-list">
              {edu.coursework.map(c => <span class="course-tag">{c}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>

    <div>
      <h3 class="mini-label">// certifications</h3>
      <div class="cert-list">
        {certificates.map(cert => (
          <div class="cert-item-minimal">
            <div class="cert-icon-box">
              {cert.logo ? <img src={cert.logo} alt={cert.name} class="cert-img" /> : <i class={cert.icon}></i>}
            </div>
            <div class="cert-text">
              <h4>{cert.name}</h4>
              <p>{cert.issuer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <h3 class="mini-label">// technical skills</h3>
  <div class="skills-grid">
    {techCategories.map(cat => (
      <div class="skill-box">
        <span class="skill-cat">{cat.name}</span>
        <div class="skill-tags">
          {cat.items.map(t => <span class="skill-tag">{t}</span>)}
        </div>
      </div>
    ))}
  </div>

  <!-- ============ PROJECTS ============ -->
  <h2 id="projects" class="sec-head">Projects</h2>
  <p class="sec-sub">Systems, experiments, and tools. 🚧 Always expanding.</p>
  <div class="projects-grid">
    {projects.map(project => (
      <div class="project-card">
        <a class="project-shot" href={project.liveUrl} target="_blank" rel="noopener" aria-label={`${project.title} — live`}>
          <img src={`/projects/${project.id}.png`} alt={`${project.title} screenshot`} />
          <span class="project-cat">{project.category}</span>
        </a>
        <div class="project-body">
          <h3>{project.title}</h3>
          <p class="project-desc">{project.description}</p>
          <div class="tech-row">
            {project.tech.map(t => <span class="tech-chip">{t}</span>)}
          </div>
          <div class="project-links">
            <a href={project.liveUrl} target="_blank" rel="noopener" class="btn btn-sm"><i class="fas fa-external-link-alt"></i><span>Live</span></a>
            <a href={project.githubUrl} target="_blank" rel="noopener" class="btn btn-sm"><i class="fab fa-github"></i><span>Source</span></a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- ============ FRIENDS ============ -->
  <h2 id="friends" class="sec-head">Friends</h2>
  <p class="sec-sub">Cool people with cool corners of the internet. (hover for the note)</p>
  {friends.length > 0 ? (
    <ul class="friends-list">
      {friends.map(f => (
        <li class="friend-row">
          <a class="friend-link" href={f.url} target="_blank" rel="noopener">{f.name}</a>
          {f.note && <span class="friend-note">— {f.note}</span>}
        </li>
      ))}
    </ul>
  ) : (
    <p class="friends-empty">// coming soon — compiling the list</p>
  )}

  <!-- ============ WRITING ============ -->
  <h2 class="sec-head">Writing</h2>
  <a class="box writing-box" href="/blog">
    <div>
      <h3>Library &amp; Notes</h3>
      <p>Blog posts, school notes, and a running list of resources.</p>
    </div>
    <span class="writing-arrow">→</span>
  </a>
</Layout>

<style>
  /* ---------- Intro box (bio + photo) ---------- */
  .intro-box {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 32px;
    padding: 32px;
    margin-bottom: 8px;
  }
  .intro-text { display: flex; flex-direction: column; justify-content: center; gap: 16px; }
  .intro-lead { font-size: 1.15rem; }
  .intro-text p { color: var(--text); line-height: 1.65; }
  .intro-text strong { font-weight: 600; }
  .inline-link { color: var(--text); text-decoration: underline; text-underline-offset: 2px; font-weight: 600; }
  .inline-link:hover { color: var(--link-blue); }
  .intro-socials { display: flex; gap: 10px; margin-top: 6px; flex-wrap: wrap; }
  .intro-socials .social:hover { background: var(--brand); color: #fff; border-color: var(--brand); }
  .intro-photo-wrap { display: flex; align-items: center; justify-content: center; }
  .intro-photo {
    width: 100%; max-width: 300px; aspect-ratio: 4 / 5; object-fit: cover; object-position: center;
    border: 1px solid var(--line); box-shadow: 5px 5px 0 0 var(--shadow);
    display: block;
  }

  /* ---------- section headings ---------- */
  .mini-label {
    font-family: var(--font-mono); font-size: 0.8rem; font-weight: 500;
    color: var(--muted); margin: 32px 0 14px; letter-spacing: 0.02em;
  }
  .resume-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: -10px; margin-bottom: 8px; flex-wrap: wrap; }

  /* ---------- About grid ---------- */
  .about-grid :global(.bento-grid) { padding: 0; }
  .travel-cell { grid-column: span 2; display: flex; }
  .travel-cell :global(.bento-card) { width: 100%; }

  .yt-card { display: flex; flex-direction: column; padding: 24px; grid-column: span 2; min-height: 220px; }
  .yt-card h3, .lbxd-head h3, .tft-head h3 { font-size: 1.1rem; font-weight: 700; margin: 0; }
  .yt-sub { margin: 6px 0 0; color: var(--muted); font-size: 0.9rem; }
  .yt-frame { margin-top: 14px; position: relative; width: 100%; flex: 1; min-height: 240px; overflow: hidden; background: #000; border: 1px solid var(--line); }
  .yt-frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }


  .tft-card { grid-column: span 2; display: flex; flex-direction: column; gap: 16px; padding: 24px; text-decoration: none; color: var(--text); }
  .tft-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .tft-id { font-family: var(--font-mono); font-size: 0.78rem; color: var(--muted); white-space: nowrap; }
  .tft-hero { display: flex; align-items: center; gap: 16px; }
  .tft-emblem { width: 60px; height: 60px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .tft-emblem img { width: 258px; max-width: none; height: auto; }
