---
import Layout from '../layouts/Layout.astro';

const name = "BRYAN";
const tagline = "The future belongs to those who believe in the possibilities of tomorrow.";

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/bryantran21', icon: 'fab fa-github' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/bryan-huy-tran', icon: 'fab fa-linkedin' },
  { label: 'Twitter', href: 'https://twitter.com/bryantran21', icon: 'fab fa-twitter' },
  { label: 'Instagram', href: 'https://instagram.com/bryan.tran', icon: 'fab fa-instagram' },
  { label: 'Email', href: 'mailto:bryantran21@gmail.com', icon: 'fas fa-envelope' },
];
---

<Layout title={name}>
  <div class="page" id="page">
    <div class="hero">
      <div class="profile-island">
        <img 
          src="/profile.jpg" 
          alt="Profile photo"
          class="profile-photo"
          id="profile-photo"
        />
      </div>

      <h1 class="name">{name}</h1>
      <p class="tagline">{tagline}</p>
      
      <div class="social-links">
        {socialLinks.map(link => (
          <a 
            href={link.href}
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class={link.icon}></i>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .page {
    min-height: 100vh;
    position: relative;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100vh;
    padding: 2rem;
  }

  .profile-photo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: 3px solid var(--border);
    object-fit: cover;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .profile-photo:hover {
    border-color: var(--accent);
  }

  .name {
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-top: 1rem;
  }

  .tagline {
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 400;
    max-width: 35rem;
    margin-bottom: 2rem;
    color: var(--text-secondary);
    text-wrap: balance;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    color: var(--text);
    padding: 0.8rem 1.2rem;
    background: var(--surface);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    transition: border-color 0.2s ease, background 0.2s ease;
    text-decoration: none !important;
  }

  .social-link:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .spinning {
    animation: spin360 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes spin360 {
    from { transform: rotate(0deg) }
    to { transform: rotate(360deg) }
  }
</style>

<script>
  const themes = [{ profile: '/profile.jpg' }, { profile: '/profile2.jpg' }];
  let currentThemeIndex = 0;
  const profilePhoto = document.getElementById('profile-photo') as HTMLImageElement;

  profilePhoto?.addEventListener('click', () => {
    profilePhoto.classList.add('spinning');
    currentThemeIndex = (currentThemeIndex + 1) % themes.length;
    setTimeout(() => { profilePhoto.src = themes[currentThemeIndex].profile; }, 350);
    setTimeout(() => { profilePhoto.classList.remove('spinning'); }, 700);
  });
</script>