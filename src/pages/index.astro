// Photo gallery. Drop images in public/photos/ and add an entry here.
// `caption` is optional.
const photos = [
  { src: '/photos/disney.jpg', caption: 'disney!' },
  { src: '/photos/mando.jpg', caption: 's/o mando' },
  { src: '/photos/match.jpg', caption: 'performative matcha consumer' },
  { src: '/photos/nyc.jpg', caption: 'nyc' },
  { src: '/photos/ny-jess.jpg', caption: 'new years' },
  { src: '/photos/colorado.jpg', caption: 'first time snowboarding' },
  { src: '/photos/grad.jpg', caption: 'graduation!' },
  { src: '/photos/seattle.jpg', caption: 'seattle' },
  { src: '/photos/pr-vicky.jpg', caption: 'puerto rico' },
];

// Friends — add your people: { name, url, note }  (note shows on hover)
const friends: { name: string; url: string; note?: string }[] = [
  { name: 'Blake', url: 'https://blakelalonde.com/', note: 'sports encyclopedia' },
  { name: 'Trevor', url: 'https://trevorhuval.github.io/', note: 'rock n roll' },
  { name: 'Anthony', url: 'https://www.linkedin.com/in/anthony-duong-849248210/', note: 'initial d fan' },
  { name: 'Horacio', url: 'https://www.linkedin.com/in/hmedin2/', note: 'bit generator' },
  { name: 'Jalen', url: 'https://www.linkedin.com/in/jalenhen/', note: "apex duo (we're plat at best)" },
