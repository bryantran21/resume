---
import Layout from '../layouts/Layout.astro';

const name = "BRYAN";
const tagline = "The future belongs to those who believe in the possibilities of tomorrow.";

const navLinks = [
  { label: 'About', href: '/about' },
  { label: 'Resume', href: '/resume' },
  { label: 'Projects', href: '/projects' },
  { label: 'Sign In', href: '#' },
];

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/bryantran21', icon: 'fab fa-github' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/bryan-huy-tran', icon: 'fab fa-linkedin' },
  { label: 'Twitter', href: 'https://twitter.com/bryantran21', icon: 'fab fa-twitter' },
  { label: 'Instagram', href: 'https://instagram.com/bryan.tran', icon: 'fab fa-instagram' },
  { label: 'Email', href: 'mailto:bryantran21@gmail.com', icon: 'fas fa-envelope' },
];
---

<Layout title={name} description={`${name} - ${tagline}`}>
  <div class="page" id="page">
    
    <nav class="navbar">
      <a href="/" class="logo">{name}</a>
      <div class="nav-links">
        {navLinks.map(link => (
          <a href={link.href} class="nav-link">{link.label}</a>
        ))}
      </div>
    </nav>

    <div class="hero">
      <div class="profile-island">
        <img 
          src="/profile.jpg" 
          alt="Profile photo"
          class="profile-photo"
          id="profile-photo"
        />
      </div>

      <h1 class="name">{name}</h1>
      <p class="tagline">{tagline}</p>
      
      <div class="social-links">
        {socialLinks.map(link => (
          <a 
            href={link.href}
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class={link.icon}></i>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  :root {
    --accent-purple: #9F55FF;
  }

  .page {
    min-height: 100vh;
    background: url('/background.jpg') center/cover no-repeat;
    position: relative;
    transition: background-image 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  /* Overlay for readability */
  .page::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.7) 100%);
    z-index: 0;
  }

  /* --- REFINED NAVBAR --- */
.navbar {
    position: fixed;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    
    display: flex;
    justify-content: space-between;
    align-items: center;
    
    /* LOCK THESE TWO VALUES ACROSS ALL FILES */
    width: 90%;
    max-width: 850px; 
    
    padding: 0.8rem 2.5rem;
    
    background: rgba(10, 10, 10, 0.4);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 100px;
  }

  .logo {
    font-size: 1.1rem;
    font-weight: 800;
    color: white;
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.3s ease;
    position: relative;
    padding: 4px 0;
  }

  .nav-link:hover {
    color: white;
  }

  /* Purple underline interaction */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--accent-purple);
    transition: all 0.3s ease;
    transform: translateX(-50%);
    border-radius: 2px;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Hero Section */
  .hero {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100vh;
    padding: 2rem;
  }

  .profile-photo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.2);
    object-fit: cover;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .profile-photo:hover {
    transform: scale(1.08) rotate(5deg);
    border-color: var(--accent-purple);
  }

  .name {
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    color: white;
    margin-top: 1rem;
    text-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .tagline {
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 400;
    max-width: 35rem;
    margin-bottom: 2rem;
    color: rgba(255, 255, 255, 0.8);
    text-wrap: balance;
  }

  /* Social Links: Glass Pills */
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    color: white;
    font-size: 1.1rem;
    padding: 0.8rem 1.2rem;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .social-link:hover {
    background: rgba(159, 85, 255, 0.2);
    border-color: var(--accent-purple);
    transform: translateY(-4px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
  }

  /* Spin animation */
  .spinning {
    animation: spin360 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes spin360 {
    from { transform: rotate(0deg) scale(1); }
    to { transform: rotate(360deg) scale(1); }
  }

  @media (max-width: 768px) {
    .navbar { width: 95%; padding: 0.6rem 1.5rem; top: 1rem; }
    .nav-links { gap: 1rem; }
    .name { font-size: 3.5rem; }
    .social-link { padding: 0.6rem 1rem; }
  }
</style>

<script>
  const themes = [
    { profile: '/profile.jpg', background: '/background.jpg' },
    { profile: '/profile2.jpg', background: '/background2.jpg' },
  ];

  let currentThemeIndex = 0;
  const profilePhoto = document.getElementById('profile-photo') as HTMLImageElement;
  const page = document.getElementById('page') as HTMLElement;

  profilePhoto?.addEventListener('click', () => {
    profilePhoto.classList.add('spinning');
    
    currentThemeIndex = (currentThemeIndex + 1) % themes.length;
    const nextTheme = themes[currentThemeIndex];
    
    setTimeout(() => {
      profilePhoto.src = nextTheme.profile;
      page.style.backgroundImage = `url('${nextTheme.background}')`;
    }, 350);
    
    setTimeout(() => {
      profilePhoto.classList.remove('spinning');
    }, 700);
  });
</script>