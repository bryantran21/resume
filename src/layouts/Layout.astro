---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Personal website and portfolio",
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/png" href="/favicon.png" />

  <script is:inline>
    const stored = localStorage.getItem('theme');
    const theme = stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <title>{title}</title>
</head>
<body>
  <div class="page">
    <header class="site-header">
      <a href="/" class="brand">Bryan Tran</a>
      <div class="header-actions">
        <a class="btn btn-accent" href="https://linkedin.com/in/bryan-huy-tran" target="_blank" rel="noopener">
          <i class="fab fa-linkedin"></i><span>LinkedIn</span>
        </a>
        <a class="btn" href="https://github.com/bryantran21" target="_blank" rel="noopener">
          <i class="fab fa-github"></i><span>GitHub</span>
        </a>
        <button id="theme-toggle" class="btn btn-icon" aria-label="Toggle color theme">
          <i class="fas fa-moon"></i>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Bryan Tran</span>
      <span class="foot-mono">built with Astro · deployed on Vercel</span>
    </footer>
  </div>

  <script is:inline>
    const btn = document.getElementById('theme-toggle');
    const icon = btn.querySelector('i');
    const sync = () => { icon.className = document.documentElement.dataset.theme === 'dark' ? 'fas fa-sun' : 'fas fa-moon'; };
    sync();
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      sync();
    });
  </script>
</body>
</html>

<style is:global>
  /* ============ Neo-brutalist cream theme ============ */
  :root,
  :root[data-theme="light"] {
    --bg:        #F4EEE1;   /* cream page */
    --panel:     #F4EEE1;   /* boxes sit on cream */
    --text:      #1A1712;   /* warm near-black */
    --muted:     #6B6152;   /* warm gray */
    --line:      #1A1712;   /* black outlines */
    --shadow:    rgba(26, 23, 18, 0.5);
    --accent:    #1A1712;   /* monochrome: "accent" == ink */
    --accent-soft: rgba(26, 23, 18, 0.06);
    --link-blue: #0A66C2;   /* the one real accent, buttons only */
    color-scheme: light;
  }

  :root[data-theme="dark"] {
    --bg:        #16150F;
    --panel:     #16150F;
    --text:      #F4EEE1;
    --muted:     #9A9384;
    --line:      #F4EEE1;
    --shadow:    rgba(244, 238, 225, 0.5);
    --accent:    #F4EEE1;
    --accent-soft: rgba(244, 238, 225, 0.08);
    --link-blue: #4d9bff;
    color-scheme: dark;
  }

  :root {
    --font-sans: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', monospace;
    /* neutralize old rounded tokens: everything is sharp */
    --radius-card: 0px;
    --radius-pill: 0px;
    /* legacy aliases so existing component CSS keeps working */
    --surface: var(--panel);
    --bg-alt: var(--bg);
    --border: var(--line);
    --border-strong: var(--line);
    --text-secondary: var(--muted);
    --text-muted: var(--muted);
    --btn-bg: var(--text);
    --btn-fg: var(--bg);
    --col: 1080px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }

  body {
    font-family: var(--font-sans);
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .page { max-width: var(--col); margin: 0 auto; padding: 0 24px; }
  main { width: 100%; }

  h1, h2, h3, h4 { font-weight: 600; color: var(--text); letter-spacing: -0.01em; }

  :focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }

  /* ---- The box: 1px ink outline + hard offset shadow, sharp corners ---- */
  .box,
  .card, .bento-card, .yt-card, .tft-card, .games-card, .lbxd-card,
  .experience-card, .interactive-edu-card, .cert-item-minimal, .tech-item,
  .project-card, .post-card, .cta-glass, .intro-box, .skill-box, .stat-box {
    background: var(--panel);
    border: 1px solid var(--line) !important;
    border-radius: 0 !important;
    box-shadow: 5px 5px 0 0 var(--shadow);
  }

  /* interactive boxes lift on hover */
  a.box, a.card, a.bento-card, a.project-card, a.post-card, a.tft-card,
  a.game-card {
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  a.box:hover, a.card:hover, a.bento-card:hover, a.project-card:hover,
  a.post-card:hover, a.tft-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 0 var(--shadow) !important;
    border-color: var(--line) !important;
  }

  /* ---- Buttons ---- */
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 0.82rem; font-weight: 500;
    line-height: 1; text-decoration: none;
    color: var(--text); background: var(--panel);
    border: 1px solid var(--line); border-radius: 0;
    padding: 8px 14px; cursor: pointer;
    box-shadow: 3px 3px 0 0 var(--shadow);
    transition: transform 0.1s ease, box-shadow 0.1s ease, background 0.1s ease, color 0.1s ease;
  }
  .btn:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 0 var(--shadow); background: var(--text); color: var(--bg); }
  .btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 0 var(--shadow); }
  .btn.btn-accent { background: var(--link-blue); color: #fff; border-color: var(--line); }
  .btn.btn-accent:hover { background: var(--link-blue); color: #fff; filter: brightness(1.08); }
  .btn.btn-icon { padding: 8px 10px; }
  .btn i { font-size: 0.95rem; }

  /* ---- Header ---- */
  .site-header {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; padding: 28px 0 24px;
  }
  .brand {
    font-family: var(--font-mono); font-weight: 700; font-size: 1.3rem;
    color: var(--text) !important; text-decoration: none; letter-spacing: -0.02em;
  }
  .header-actions { display: flex; align-items: center; gap: 10px; }

  /* ---- Footer ---- */
  .site-footer {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
    border-top: 1px solid var(--line);
    margin-top: 64px; padding: 20px 0 40px;
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted);
  }

  /* mono section headings used across pages */
  .sec-head {
    font-family: var(--font-mono); font-weight: 700;
    font-size: 1.35rem; letter-spacing: -0.01em; color: var(--text);
    margin: 56px 0 22px;
  }
  .sec-sub { color: var(--muted); font-size: 0.95rem; margin: -14px 0 24px; }

  @media (max-width: 640px) {
    .site-header { flex-wrap: wrap; gap: 12px; padding: 18px 0; }
    .btn span { display: none; }
    .btn.btn-icon span { display: none; }
    .brand { font-size: 1.15rem; }
  }
</style>
