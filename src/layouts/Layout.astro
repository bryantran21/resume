---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Personal website and portfolio",
} = Astro.props;

const navLinks = [
  { label: 'About', href: '/#about', section: 'about' },
  { label: 'Resume', href: '/#resume', section: 'resume' },
  { label: 'Projects', href: '/#projects', section: 'projects' },
  { label: 'Blog', href: '/blog', section: null },
];

const pathname = new URL(Astro.url).pathname;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/png" href="/favicon.png" />

  <script is:inline>
    const stored = localStorage.getItem('theme');
    const theme = stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <title>{title}</title>
</head>
<body>
  <nav class="navbar">
    <a href="/" class="logo">BRYAN</a>
    <div class="nav-links">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link ${link.section === null && pathname.startsWith('/blog') ? 'active' : ''}`}
          data-section={link.section}
        >
          {link.label}
        </a>
      ))}
    </div>
    <button id="theme-toggle" class="theme-toggle" aria-label="Toggle color theme">
      <i class="fas fa-moon"></i>
    </button>
  </nav>

  <main>
    <slot />
  </main>

  <script is:inline>
    const btn = document.getElementById('theme-toggle');
    const icon = btn.querySelector('i');
    const sync = () => { icon.className = document.documentElement.dataset.theme === 'dark' ? 'fas fa-sun' : 'fas fa-moon'; };
    sync();
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      sync();
    });
  </script>

  <script is:inline>
    if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      const sections = document.querySelectorAll('main section');
      sections.forEach(el => el.classList.add('reveal'));
      const io = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -80px 0px' });
      sections.forEach(el => io.observe(el));
    }
  </script>

  <script is:inline>
    if (location.pathname === '/') {
      const navLinkEls = document.querySelectorAll('.nav-link[data-section]');
      const spySections = Array.from(navLinkEls)
        .map(l => l.dataset.section)
        .filter(Boolean)
        .map(id => document.getElementById(id))
        .filter(Boolean);

      const setActive = (id) => {
        navLinkEls.forEach(l => l.classList.toggle('active', l.dataset.section === id));
      };

      const spy = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });

      spySections.forEach(el => spy.observe(el));
    }
  </script>
</body>
</html>

<style is:global>
  :root,
  :root[data-theme="light"] {
    --bg:              #FBFBF9;
    --bg-alt:          #F2F1EC;
    --surface:         #FFFFFF;
    --text:            #141414;
    --text-secondary:  #5C5C5A;
    --text-muted:      #8A8783;
    --border:          #E5E2DB;
    --border-strong:   #D6D2C9;
    --accent:          #6D28D9;
    --accent-soft:     #F1EBFB;
    --btn-bg:          #141414;
    --btn-fg:          #FBFBF9;
  }

  :root[data-theme="dark"] {
    --bg:              #0B0B0C;
    --bg-alt:          #101012;
    --surface:         #141416;
    --text:            #FAFAFA;
    --text-secondary:  #8E8E93;
    --text-muted:      #6E6E73;
    --border:          rgba(255,255,255,0.09);
    --border-strong:   rgba(255,255,255,0.16);
    --accent:          #A78BFA;
    --accent-soft:     rgba(167,139,250,0.12);
    --btn-bg:          #FAFAFA;
    --btn-fg:          #0B0B0C;
  }

  :root {
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', monospace;
    --maxw: 900px;
    --radius-card: 12px;
    --radius-pill: 100px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root[data-theme="light"] {
    color-scheme: light;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  body {
    font-family: var(--font-sans);
    background-color: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  main {
    width: 100%;
  }

  h1, h2, h3, h4 {
    font-weight: 600;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  main section.reveal {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  main section.reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .navbar {
    position: fixed;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    width: 90%;
    max-width: 850px;
    padding: 0.8rem 1.5rem 0.8rem 2.5rem;

    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill) !important;
  }

  .logo {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text) !important;
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-link {
    color: var(--text-secondary) !important;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.2s ease;
    position: relative;
    padding: 6px 0;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text) !important;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: all 0.2s ease;
    transform: translateX(-50%);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.8rem;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .theme-toggle:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  @media (max-width: 768px) {
    .navbar {
      top: 1rem;
      padding: 0.7rem 1rem 0.7rem 1.5rem;
      width: 95%;
    }
    .nav-links { gap: 1rem; }
    .nav-link { font-size: 0.8rem; }
  }
</style>
