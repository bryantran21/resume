---
import DarkVeil from '../components/DarkVeil';

interface Props {
  title: string;
  description?: string;
  showWaves?: boolean;
}

const { 
  title, 
  description = "Personal website and portfolio",
  showWaves = true 
} = Astro.props;

const navLinks = [
  { label: 'About', href: '/about' },
  { label: 'Resume', href: '/resume' },
  { label: 'Projects', href: '/projects' },
  { label: 'Blog', href: '/blog' },
];

const pathname = new URL(Astro.url).pathname;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link href="https://fonts.cdnfonts.com/css/sf-pro-display" rel="stylesheet">
  <title>{title}</title>
</head>
<body>
  {showWaves && (
    <DarkVeil 
      client:only="react" 
      speed={0.2} 
      hueShift={280} /* Adjusted for deeper purple */
      noiseIntensity={0.04}
      brightness={0.3} /* Increased brightness for a punchier purple */
      warpAmount={0.2}
    />
  )}

  <nav class="navbar">
    <a href="/" class="logo">BRYAN</a>
    <div class="nav-links">
      {navLinks.map(link => (
        <a 
          href={link.href} 
          class={`nav-link ${pathname === link.href ? 'active' : ''}`}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>

  <main>
    <slot />
  </main>
</body>
</html>

<style is:global>
  :root {
    --accent-purple: #9F55FF;
    --bg-black: #000000;
    --text-secondary: rgba(255, 255, 255, 0.7);
    --font-sans: 'SF Pro Display', 'SF Pro Text', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: var(--font-sans);
    background-color: var(--bg-black);
    color: white;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  /* GATEKEEPER: Ensures your pages stay transparent. */
  main, 
  .page, 
  .about-page, 
  .projects-page, 
  .resume-page,
  .content-wrapper {
    background-color: transparent !important;
    position: relative;
    z-index: 10;
  }

  main {
    width: 100%;
  }

  .navbar {
    position: fixed;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 90%;
    max-width: 850px; 
    padding: 0.8rem 2.5rem;
    
    /* Obsidian Glass Effect */
    background: rgba(10, 10, 10, 0.4);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    
    border: 1px solid rgba(255, 255, 255, 0.08);
    /* Re-added pill shape */
    border-radius: 100px !important; 
  }

  .logo {
    font-size: 1.1rem;
    font-weight: 800;
    color: white !important;
    letter-spacing: 0.1em; 
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-link {
    color: var(--text-secondary) !important;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.3s ease;
    position: relative;
    padding: 6px 0;
  }

  .nav-link:hover, 
  .nav-link.active {
    color: white !important;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--accent-purple);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateX(-50%);
    border-radius: 2px;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  @media (max-width: 768px) {
    .navbar {
      top: 1rem;
      padding: 0.7rem 1.5rem;
      width: 95%;
    }
    .nav-links { gap: 1rem; }
    .nav-link { font-size: 0.8rem; }
  }
</style>